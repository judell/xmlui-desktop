<App layout="vertical-sticky" var.rightPaneSize="(measuring…)" var.updateBannerDismissedVersion="{window.__bramRestoreUpdateBannerDismissed ? window.__bramRestoreUpdateBannerDismissed() : ''}" var.toplevelBannerDismissed="{false}" var.strayScaffoldBannerDismissed="{false}" var.setupCompleteProvider="{''}" var.lastSeenAgentVerb="{''}" var.transcriptAgentId="{''}" var.sendNoticeDismissed="{window.__bramRestoreSendNoticeDismissed()}" var.dismissedAgentIds="{window.__bramRestoreDismissedAgents()}"
  onInit="startBramLatestJsonlPush(() => (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || '')">
  <PushSource
    id="mainAgentStatus"
    initial="{null}"
    subscribe="{window.bramSubscribeAgentStatus()}" />
  <PushSource
    id="agentSwitcherBusy"
    initial="{false}"
    subscribe="{window.bramSubscribeAgentSwitcherBusy()}" />
  <!-- transcript-new-below-badge: pane-wide unseen counter feed (helpers.js;
       pushed, never polled). The echo guard ended the yank-to-bottom, which
       had doubled as the "agent responded" signal; the header chip replaces
       it — visible on every tab, one click to the transcript's live edge.
       App scope so the AppHeader can bind it. -->
  <PushSource
    id="transcriptUnseen"
    initial="{window.__bramUnseenValue ? window.__bramUnseenValue() : 0}"
    subscribe="{window.bramSubscribeTranscriptUnseen ? window.bramSubscribeTranscriptUnseen() : null}" />
  <!-- PTY-throughput subscription now lives inside ActivitySparkline so its
       per-chunk churn is isolated from the footer composer. -->

  <PushSource
    id="enhanceStatusEvt"
    initial="{0}"
    subscribe="{window.bramSubscribeEnhanceStatusTick()}" />
  <PushSource
    id="rightPaneSizeEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeRightPaneSize()}" />
  <PushSource
    id="whisperNotice"
    initial="{null}"
    subscribe="{window.bramSubscribeWhisperUnavailable()}" />
  <PushSource
    id="voiceBusyNotice"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceBusy()}" />
  <ChangeListener
    listenTo="{whisperNotice.value &amp;&amp; whisperNotice.value.at}"
    onDidChange="() => window.__bramToastWhisperNotice(whisperNotice.value, toast)" />
  <ChangeListener
    listenTo="{voiceBusyNotice.value &amp;&amp; voiceBusyNotice.value.at}"
    onDidChange="(c) => { if (c.newValue) { toast('A voice recording is already in progress. Return to that recording to stop it. If you can\'t find it, reload Bram to clear it.'); } }" />
  <ChangeListener
    listenTo="{enhanceStatusEvt.value}"
    onDidChange="() => { window.__bramIframeTrace('refetch-called', {context: 'enhance-status-changed'}); enhanceStatus.refetch(); startBramLatestJsonlPush(() => (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || ''); }" />
  <ChangeListener
    listenTo="{rightPaneSizeEvt.value}"
    onDidChange="() => { const s = rightPaneSizeEvt.value || null; rightPaneSize = s ? (s.width + ' × ' + s.height) : '(measuring…)'; }" />
  <DataSource id="enhanceStatus" url="/__enhance/status" />
  <DataSource id="rpInfo" url="/__right-pane-info" />
  <!-- issue-221-skill-launcher: project skills from .claude/skills/*/SKILL.md.
       Refetched on open and when enhance-status-changed fires. -->
  <DataSource id="skillsList" url="/__context/skills" />
  <!-- App-scope read of the inflight worklist claim, so the header can show
       "Approving/Iterating/Dropping <item>" even when you've left the Worklist tab.
       issue-265: the url carries NO cache-busting tick. DataSource shares one
       cache entry across every instance with the same url/queryParams/body
       (https://www.xmlui.org/docs/reference/components/DataSource — "mounting
       two DataSource instances with the same url ... calls the handler once and
       shares the result across consumers"), so this and Workspace's
       inflightClaim are one source of truth. A per-component tick in the url
       silently split them into two cache entries that drifted apart, which was
       the whole of #265. Refresh via refetch(), which invalidates the shared
       entry for all consumers. -->
  <DataSource id="headerInflightClaim" url="/__inflight" />
  <PushSource
    id="headerInflightEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('inflight-claim-changed')}" />
  <ChangeListener
    listenTo="{headerInflightEvt.value}"
    onDidChange="() => { headerInflightClaim.refetch(); window.__bramIframeTrace('refetch-called', {context: 'header-inflight-claim-changed'}); }" />
  <!-- Backup driver: the dedicated inflight-claim-changed subscription dedups
       against Workspace's, so also refetch whenever the agent status changes
       (App-scope push that's already proven). An in-flight action always makes
       the agent work, so this reliably picks the claim up and drops it. -->
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state}"
    onDidChange="() => { headerInflightClaim.refetch(); window.__bramIframeTrace('header-inflight-refetch', {state: (mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state) || ''}); }" />
  <DataSource id="appInfo" url="/__app-info" />
  <!-- clickable-update-from-banner: self-update progress for the banner.
       Pushed, never polled: the host emits self-update-changed on every
       state/phase transition. -->
  <DataSource id="selfUpdate" url="/__self-update/status" />
  <PushSource
    id="selfUpdateEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('self-update-changed')}" />
  <ChangeListener
    listenTo="{selfUpdateEvt.value}"
    onDidChange="() => { selfUpdate.refetch(); window.__bramIframeTrace('refetch-called', {context: 'self-update-changed'}); }" />
  <!-- issue-231 footer tips: settings snapshot feeds the relevance gates
       (Tool Descriptions / batch actions); tick bumps re-pick on dismiss
       or next. One-shot fetch, no polling. -->
  <DataSource id="footerTipSettings" url="/__settings" />
  <variable name="footerTipTick" value="{0}" />
  <LocalLinkPreview />
  <!-- Live session meta for the footer echo (mirrors Transcript's source):
       /__sessions/list flags the current session; refetch on changes so the
       footer line tracks the growing live file. -->
  <DataSource
    id="footerSessions"
    url="/__sessions/list"
    queryParams="{{ limit: 20 }}" />
  <PushSource
    id="footerSessionsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <ChangeListener
    listenTo="{footerSessionsChangedEvt.value &amp;&amp; footerSessionsChangedEvt.value.tick}"
    onDidChange="() => { footerSessions.refetch(); footerAgents.refetch(); }" />
  <!-- footer-indexing-status: search-indexer state for the first-row
       indicator. Pushed via search-index-changed (no polling); refetch on
       its tick. -->
  <DataSource id="footerIndexStatus" url="/__search-index-status" />
  <PushSource
    id="footerIndexChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('search-index-changed')}" />
  <ChangeListener
    listenTo="{footerIndexChangedEvt.value &amp;&amp; footerIndexChangedEvt.value.tick}"
    onDidChange="() => footerIndexStatus.refetch()" />
  <!-- Subagent roster for the footer chips strip, and main-model metadata
       for the footer session line. Refreshed by both session and subagent
       signals: subagent JSONL appends are swallowed by the watcher's
       session-JSONL branch and never reach sessions-list-changed, which
       left chips stale until the main conversation next moved. -->
  <DataSource
    id="footerAgents"
    url="/__agents"
    onError="() => null" />
  <PushSource
    id="subagentsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('subagents-changed')}" />
  <ChangeListener
    listenTo="{subagentsChangedEvt.value &amp;&amp; subagentsChangedEvt.value.tick}"
    onDidChange="() => footerAgents.refetch()" />
  <!-- Pending permission menu for the footer mount — the single canonical
       menu surface: same place on every tab, always visible. Replaces the
       Transcript inline interleave and the Worklist-dock mount. -->
  <PushSource
    id="footerAgentMenuEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeAgentMenu()}" />
  <!-- Send-ledger affordance (esc/resend redesign phase 3): the host's
       outbound-send ledger drives a PASSIVE status note (no buttons) and
       a composer restore for user-caused strands. The old message-bounced
       emit was deleted with the rest of the bounce heuristics in
       delete-phase tranche 3a (#214). -->
  <PushSource
    id="sendLedgerEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('send-ledger-changed')}" />
  <DataSource id="sendLedgerDs" url="/__send-ledger" />
  <ChangeListener
    listenTo="{sendLedgerEvt.value &amp;&amp; sendLedgerEvt.value.tick}"
    onDidChange="() => sendLedgerDs.refetch()" />
  <!-- issue-234 terminal-attention banner: host-detected unattended boot
       prompt (no open turn + PTY byte-silence + prompt-shaped tail),
       joined client-side with terminal-pane visibility — only the parent
       shell knows that half. Sibling to the suspicious-silence PushSource
       in FooterAgentStatus.xmlui, but declared here (not per-component)
       because the banner itself renders in this footer, beside the
       send-ledger notice below. The source is push-only; it adds no
       polling or independent refresh loop. -->
  <PushSource
    id="terminalAttentionEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTerminalAttention()}" />
  <!-- compaction-in-progress-banner: host-detected active compaction (a
       text-PRESENCE match on the live PTY tail — NOT the byte-silence
       terminal_attention path above), joined client-side with
       terminal-pane visibility and an episode-keyed dismiss — see
       bramSubscribeCompaction, helpers.js. -->
  <PushSource
    id="compactionEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeCompaction()}" />
  <!-- toast-issue-closed-on-push: toast when the user's Push auto-closes a
       queued issue. Host emits issues-closed-on-push after the close flush. -->
  <PushSource
    id="issuesClosedOnPushEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('issues-closed-on-push')}" />
  <ChangeListener
    listenTo="{issuesClosedOnPushEvt.value &amp;&amp; issuesClosedOnPushEvt.value.tick}"
    onDidChange="() => window.__bramToastIssuesClosed(issuesClosedOnPushEvt.value, toast)" />
  <!-- Light-touch backstop: the always-mounted footer never re-mounts, so its
       session meta can stay frozen at launch values. Refetch on agent
       turn-state transitions (the App-scope status push already driving the
       header) so date/size land on current values after each turn — no
       polling, ~once per turn. -->
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state}"
    onDidChange="() => { footerSessions.refetch(); footerAgents.refetch(); }" />
  <APICall
    id="restartServer"
    url="/__restart-server"
    method="get"
    onSuccess="rpInfo.refetch()" />
  <APICall
    id="runEnhanceSetup"
    url="/__enhance/run"
    method="get"
    onError="setupCompleteProvider = ''; enhanceStatus.refetch()" />
  <ChangeListener
    listenTo="{enhanceStatus.value &amp;&amp; enhanceStatus.value.providerNeedsSetup}"
    onDidChange="(c) => { if (c.newValue) { if ($pathname !== '/') navigate('/'); window.scrollAllToTop(); } }" />
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.verb}"
    onDidChange="(c) => { if (c.newValue) { lastSeenAgentVerb = c.newValue; } }" />
  <!-- turn-complete-beep: soft audio cue when the agent finishes a turn OR
       a permission menu appears, gated on the per-user localStorage
       preference (default off). -->
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state}"
    onDidChange="(c) => window.__bramBeepOnTurnState(c.newValue)" />
  <ChangeListener
    listenTo="{footerAgentMenuEvt.value}"
    onDidChange="() => window.__bramBeepOnMenu(footerAgentMenuEvt.value)" />
  <ChangeListener
    listenTo="{((mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state) || '') + '|' + ((mainAgentStatus.value &amp;&amp; mainAgentStatus.value.provider) || (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || '') + '|' + ((mainAgentStatus.value || enhanceStatus.value) ? '1' : '0')}"
    onDidChange="() => {
      const s = mainAgentStatus.value || {};
      const provider = s.provider || (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || '';
      const branch = s.state === 'working'
        ? 'working'
        : (s.state === 'finished'
          ? 'finished'
          : ((mainAgentStatus.value || enhanceStatus.value) &amp;&amp; provider ? 'idle-provider' : 'none'));
      if (!window.bramAgentMenu) window.__bramIframeTrace('agent-header-branch', {
        branch,
        state: s.state || '',
        verb: s.verb || '',
        provider,
        source: s.source || '',
        elapsed: s.elapsedText || '',
        lastSeenAgentVerb: lastSeenAgentVerb || ''
      });
    }" />

  <ModalDialog id="setupInfoDialog" title="About agent coordination">
    <VStack gap="$space-3">
      <Text>
        Bram configures this repo so AI agents share a worklist-driven coordination flow. Setup and refresh both install a small, idempotent set of files; rerunning is safe.
      </Text>
      <VStack gap="$space-1">
        <Text fontWeight="bold">What setup and refresh do</Text>
        <Text>• Writes the shared `resources/.worklist-authorization.json` record that every adapter consumes.</Text>
        <Text>• Refreshes the conventions sidecar so Claude and Codex use the current Bram workflow after upgrades.</Text>
        <Text>• Installs the Claude adapter: a `CLAUDE.md` @-import of the conventions sidecar plus worklist-guard and permission-menu hooks.</Text>
        <Text>• Installs the Codex adapter: an `AGENTS.md` block, top-level `developer_instructions`, and worklist-guard plus permission-menu hooks in `~/.codex/config.toml` / `~/.bram`.</Text>
      </VStack>
      <VStack gap="$space-1">
        <Text fontWeight="bold">After setup runs</Text>
        <Text>Later launches of any supported agent in this repo will not prompt again unless the setup artifacts are removed. Additional agent adapters can plug into the same flow in the future.</Text>
      </VStack>
    </VStack>
  </ModalDialog>

  <!-- issue-221-skill-launcher: pick a project skill, add an optional argument,
       and submit it as a /skill turn. Claude-only (the launch button is gated
       on activeProvider). 85% of the available width so the table has room. -->
  <Theme maxWidth-ModalDialog="85vw">
  <ModalDialog id="skillsDialog" title="Run a skill">
    <VStack gap="$space-3" padding="$space-2">
      <Text
        when="{!(skillsList.value &amp;&amp; skillsList.value.skills &amp;&amp; skillsList.value.skills.length > 0)}"
        color="$textColor-secondary">
        No project skills found in .claude/skills/.
      </Text>
      <VStack
        gap="$space-2"
        when="{skillsList.value &amp;&amp; skillsList.value.skills &amp;&amp; skillsList.value.skills.length > 0}">
        <TextArea
          id="skillArgsBox"
          placeholder="optional — freeform text passed to the skill (a path, a name, an instruction…)"
          autoComplete="off"
          autoCorrect="{false}"
          spellCheck="{false}"
          autoCapitalize="off"
          minRows="1"
          maxRows="4"
          width="100%" />
        <!-- Table with a custom Link cell for the clickable skill name; the
             description column wraps on its own. Pattern:
             https://docs.xmlui.org/howto/render-a-custom-cell-with-components -->
        <Table data="{skillsList.value.skills}">
          <!-- Star sizing: skill 1 share (1/4), description 3 shares (3/4).
               https://docs.xmlui.org/components/Column#width -->
          <Column header="Skill" width="*">
            <Link
              onClick="window.__bramRunSkill($item.name, skillArgsBox &amp;&amp; skillArgsBox.value); skillsDialog.close(); window.__bramSetVisibleRange(null); navigate('/transcript')"
              noIndicator="true">
              <Text
                value="{$item.name}"
                fontFamily="$fontFamily-monospace"
                fontWeight="$fontWeight-bold"
                whiteSpace="nowrap" />
            </Link>
          </Column>
          <!-- Text cell wraps; a bare bindTo column truncates with an ellipsis.
               https://docs.xmlui.org/howto/modify-a-value-reported-in-a-column -->
          <Column header="Description" width="3*">
            <Text
              value="{$item.description}"
              fontSize="$fontSize-sm"
              overflowMode="flow"
              breakMode="word" />
          </Column>
        </Table>
      </VStack>
    </VStack>
  </ModalDialog>
  </Theme>

  <ModalDialog id="urlInfoDialog" title="Target app info">
    <VStack gap="$space-3">
      <VStack gap="$space-1" var.browserUrl="{rpInfo.value ? (rpInfo.value.spawned ? ('http://localhost:' + rpInfo.value.spawned.port + rpInfo.value.spawned.path) : rpInfo.value.default_right_pane) : ''}">
        <Text fontWeight="bold">URL</Text>
        <Text fontFamily="$fontFamily-monospace" fontSize="$fontSize-sm">{browserUrl}</Text>
        <HStack gap="$space-2">
          <Button
            label="Open in browser"
            size="sm"
            onClick="browserUrl &amp;&amp; openExternal(browserUrl)" />
        </HStack>
      </VStack>

      <VStack gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">Screen size</Text>
        <Text fontFamily="$fontFamily-monospace" value="{rightPaneSize}" />
      </VStack>

      <VStack when="{appInfo.value}" gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">Version</Text>
        <HStack gap="$space-2">
          <Text>current:</Text>
          <Text fontFamily="$fontFamily-monospace">{appInfo.value.current}</Text>
        </HStack>
        <HStack gap="$space-2" when="{appInfo.value.latest}">
          <Text>latest:</Text>
          <Text fontFamily="$fontFamily-monospace">{appInfo.value.latest}</Text>
        </HStack>
        <Text when="{appInfo.value.has_update}" color="$color-warn-600" fontSize="$fontSize-sm">
          A newer release is available.
        </Text>
      </VStack>

      <VStack gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">About Bram</Text>
        <HStack gap="$space-2">
          <Button
            label="README on GitHub"
            size="sm"
            onClick="openExternal('https://github.com/judell/bram/blob/main/README.md')" />
        </HStack>
      </VStack>

      <VStack when="{rpInfo.value &amp;&amp; rpInfo.value.spawned}" gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">Project server (.bram.json)</Text>
        <HStack gap="$space-2">
          <Text>command:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.command}</Text>
        </HStack>
        <HStack gap="$space-2" when="{rpInfo.value.spawned.cwd}">
          <Text>cwd:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.cwd}</Text>
        </HStack>
        <HStack gap="$space-2">
          <Text>port:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.port}</Text>
        </HStack>
        <HStack gap="$space-2">
          <Text>path:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.path}</Text>
        </HStack>
        <HStack gap="$space-2" marginTop="$space-1">
          <Button
            label="Restart project server"
            size="sm"
            onClick="restartServer.execute()" />
        </HStack>
      </VStack>

      <VStack
        when="{rpInfo.value &amp;&amp; !rpInfo.value.spawned &amp;&amp; rpInfo.value.url === rpInfo.value.default_right_pane}"
        gap="$space-1"
        marginTop="$space-2">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary">
          No `.bram.json` declared — using the internal loopback default. Legacy `.xmlui-desktop.json` is also supported.
        </Text>
      </VStack>
    </VStack>
  </ModalDialog>

  <!-- update-banner-two-rows: the offer and the outcome each own a row — a
       single wrapping stream read as a run-on paragraph in the done state.
       wrapContent still guards each row on narrow windows (update-banner-wrap;
       https://www.xmlui.org/docs/reference/components/Stack#wrapcontent). -->
  <VStack
    when="{appInfo.value &amp;&amp; appInfo.value.has_update &amp;&amp; appInfo.value.latest !== updateBannerDismissedVersion}"
    backgroundColor="$color-warn-100"
    padding="$space-2"
    gap="$space-1">
    <HStack gap="$space-3" wrapContent="true" verticalAlignment="center">
      <Text fontSize="$fontSize-sm">
        Version {appInfo.value.latest} is available. (Current: {appInfo.value.current}.)
      </Text>
      <!-- clickable-update-from-banner: Update now runs the published install
           script host-side (POST /__self-update); View release keeps the
           learn-more / DIY path. Outcome row below rides the selfUpdate
           DataSource, refetched on the self-update-changed push. -->
      <Button
        when="{!selfUpdate.value || (selfUpdate.value.state !== 'running' &amp;&amp; selfUpdate.value.state !== 'done')}"
        label="Update now"
        size="xs"
        onClick="window.__bramStartSelfUpdate()" />
      <Button
        label="View release"
        size="xs"
        variant="outlined"
        onClick="appInfo.value.release_url &amp;&amp; openExternal(appInfo.value.release_url)" />
    </HStack>
    <HStack
      when="{selfUpdate.value &amp;&amp; selfUpdate.value.state !== 'idle'}"
      gap="$space-3"
      wrapContent="true"
      verticalAlignment="center">
      <Text
        when="{selfUpdate.value.state === 'running'}"
        fontSize="$fontSize-sm"
        color="$textColor-secondary">
        Updating… ({selfUpdate.value.phase})
      </Text>
      <Text
        when="{selfUpdate.value.state === 'failed'}"
        fontSize="$fontSize-sm"
        color="$color-danger-500"
        maxLines="1"
        tooltip="{(selfUpdate.value.tail || []).join('\n').slice(0, 1000)}">
        Update failed: {selfUpdate.value.error}
      </Text>
      <Text
        when="{selfUpdate.value.state === 'done'}"
        fontSize="$fontSize-sm">
        Installed {selfUpdate.value.target_version} to {selfUpdate.value.installed_to} — takes effect next launch; no rush.
      </Text>
      <Button
        when="{selfUpdate.value.state === 'done'}"
        label="Relaunch now"
        size="xs"
        variant="outlined"
        tooltip="Optional: quit this Bram and start the freshly installed one. Dismiss to keep working — the update applies whenever you next launch."
        onClick="window.__bramSelfUpdateRelaunch()" />
    </HStack>
    <!-- Row 3 — dismiss, with its message as text instead of a floating ✕
         (the SpaceFiller-pushed ✕ wrapped into an orphan line on narrow
         windows). -->
    <HStack gap="$space-2" wrapContent="true" verticalAlignment="center">
      <Button
        label="Dismiss"
        size="xs"
        variant="ghost"
        onClick="updateBannerDismissedVersion = window.__bramDismissUpdateBanner(appInfo.value.latest)" />
      <Text fontSize="$fontSize-sm" color="$textColor-secondary">
        The banner returns when a newer version is released.
      </Text>
    </HStack>
  </VStack>

  <!-- project-identity-chip: two Brams side by side are otherwise
       pixel-identical inside the pane, and the OS title bar (the only
       place the project appears) is absent from screenshots. The band
       wash is the preattentive half — you identify the window without
       reading it; the pill carries the actual path, repo in tooltip.
       The wash goes on AppHeader itself, not the inner HStack: that
       HStack sits inside paddingHorizontal-AppHeader and begins after
       the header's logo region, so its background stopped short of
       both edges. -->
  <AppHeader backgroundColor="{window.__bramProjectBandTint(appInfo.value)}">
    <Theme fontSize-Button="$fontSize-md">
      <HStack gap="$space-0_5" verticalAlignment="center" width="100%">
        <!-- Badge takes a dynamic background only via colorMap:
             https://docs.xmlui.org/components/Badge -->
        <Theme textTransform-Badge="none">
          <Badge
            when="{appInfo.value &amp;&amp; appInfo.value.project}"
            variant="pill"
            marginRight="$space-8"
            value="{appInfo.value.project}"
            colorMap="{window.__bramProjectColorMap(appInfo.value)}"
            tooltip="{window.__bramProjectTooltip(appInfo.value)}" />
        </Theme>
        <RadioGroup
          id="agentSwitcherSelect"
          when="{(mainAgentStatus.value &amp;&amp; mainAgentStatus.value.provider) || (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider)}"
          orientation="horizontal"
          initialValue="{(mainAgentStatus.value &amp;&amp; mainAgentStatus.value.provider) || (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider)}"
          enabled="{!agentSwitcherBusy.value}"
          tooltip="{agentSwitcherBusy.value ? 'Agent switch in progress' : 'Switch terminal agent'}"
          onDidChange="(next) => window.__bramHandleAgentSwitcherChange(next, (mainAgentStatus.value &amp;&amp; mainAgentStatus.value.provider) || (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || '', agentSwitcherSelect, toast)">
          <Option value="claude" label="Claude" />
          <Option value="codex" label="Codex" />
        </RadioGroup>
        <!-- switch-to-transcript-on-action: the "Starting <item>…" claim
             message moved to the footer status line (Jon: it belongs there,
             not in the app header) — see the footer HStack below. -->
        <SpaceFiller />
        <Theme fontSize-Button="$fontSize-lg">
          <Button
            label="ⓘ"
            variant="ghost"
            tooltip="Show target app info"
            onClick="rpInfo.refetch(); urlInfoDialog.open()" />
        </Theme>
        <Button
          label="A−"
          variant="ghost"
          tooltip="Decrease app font size"
          onClick="window.setAppFontSize(window.getAppFontSize() - 1)" />
        <Button
          label="A+"
          variant="ghost"
          tooltip="Increase app font size"
          onClick="window.setAppFontSize(window.getAppFontSize() + 1)" />
        <Inspector src="{'/__vendor/xs-diff.html?v=' + window.APP_VERSION}" />
      </HStack>
    </Theme>
  </AppHeader>

  <NavPanel>
    <property name="logoTemplate">
      <Fragment/>
    </property>
    <property name="footerTemplate">
      <Fragment/>
    </property>
    <!-- worklist2 cutover complete: the legacy Workspace tab and its
         Show legacy Worklist setting were retired in the 0.5.3 run. -->
    <NavLink label="Awaiting You" to="/needs-you" />
    <NavLink label="Worklist" to="/worklist2" />
    <NavLink label="Transcript" to="/transcript" />
    <NavLink label="Search" to="/search" />
    <NavLink label="Issues" to="/issues" />
    <NavLink label="Commits" to="/commits" />
    <NavLink label="Queue" to="/queue" />
    <NavLink label="History" to="/history" />
    <NavLink label="Sessions" to="/sessions" />
    <NavLink label="Tips" to="/tips" />
    <NavLink label="Context" to="/context" />
    <NavLink label="Status" to="/status" />
    <NavLink label="Settings" to="/settings" />
  </NavPanel>

  <!-- Mis-launch notices. Bram manages whatever directory it is launched from,
       and every downstream symptom of a wrong one (cold index, no sessions, no
       history) names a consequence rather than the cause. The AppHeader band
       tint already varies by project path, but it answers "which project is
       this?" for someone who believes they are in the right one — on
       2026-08-18 the tint changed for a launch in ~/community-calendar/xmlui
       instead of ~/community-calendar and was read past. Hence words, at
       startup, naming the ABSOLUTE path: the two differ only in the last
       component, so a basename would have read as correct. -->
  <VStack
    when="{enhanceStatus.value && enhanceStatus.value.firstRun && enhanceStatus.value.nestedUnder}"
    padding="$space-4"
    gap="$space-2"
    backgroundColor="$color-warn-50"
    borderBottom="1px solid $color-warn-200">
    <Heading level="h3">Already inside a Bram project — did you mean the parent?</Heading>
    <Text fontSize="$fontSize-sm">
      <Text inline="true" fontWeight="$fontWeight-bold" value="{enhanceStatus.value.nestedUnder}" />
      is already a Bram project. Launching in
      <Text inline="true" fontWeight="$fontWeight-bold" value="{enhanceStatus.value.projectRoot}" />
      manages the subdirectory separately, with its own index, worklist and hooks.
    </Text>
    <Text fontSize="$fontSize-sm" color="$textColor-secondary">
      Nested managed projects are almost never intended. If this was a mistake, quit and
      relaunch from the parent — nothing here is seeded until Setup runs.
    </Text>
  </VStack>

  <VStack
    when="{enhanceStatus.value && enhanceStatus.value.firstRun && !enhanceStatus.value.nestedUnder}"
    padding="$space-4"
    gap="$space-2"
    backgroundColor="$color-info-50"
    borderBottom="1px solid $color-info-200">
    <Heading level="h3">Bram is starting for the first time in this repo</Heading>
    <Text fontSize="$fontSize-sm">
      It will manage
      <Text inline="true" fontWeight="$fontWeight-bold" value="{enhanceStatus.value.projectRoot}" />.
      Setup writes <Text inline="true" fontFamily="$fontFamily-monospace" value=".bram.json" />,
      <Text inline="true" fontFamily="$fontFamily-monospace" value="AGENTS.md" />,
      <Text inline="true" fontFamily="$fontFamily-monospace" value="resources/" /> (worklist, port
      sidecar, traces) and <Text inline="true" fontFamily="$fontFamily-monospace" value=".claude/" />
      (conventions, hooks, skills, settings).
    </Text>
    <Text
      when="{enhanceStatus.value.gitToplevel}"
      fontSize="$fontSize-sm" color="$textColor-secondary">
      Note: this is a subdirectory of the git repo
      <Text inline="true" fontWeight="$fontWeight-bold" value="{enhanceStatus.value.gitToplevel}" />.
    </Text>
  </VStack>

  <!-- warn-when-git-toplevel-above-root: standing banner whenever the
       project root sits inside a larger git repo (the firstRun note above
       covers only the first launch). Consequence in user terms, both paths
       named. Dismissal is session-scoped on purpose (the 30033d8 lesson:
       ✕ means "not now", not "never") — an intentional monorepo subproject
       re-dismisses per launch or lives with one line. -->
  <HStack
    when="{enhanceStatus.value &amp;&amp; enhanceStatus.value.gitToplevel &amp;&amp; !toplevelBannerDismissed}"
    backgroundColor="$color-warn-100"
    padding="$space-2"
    gap="$space-3"
    wrapContent="true"
    verticalAlignment="center">
    <Text fontSize="$fontSize-sm">
      This folder has no git repository of its own — commits, diffs, and attribution here
      operate on the enclosing repo
      <Text inline="true" fontWeight="$fontWeight-bold" value="{enhanceStatus.value.gitToplevel}" />.
      If that isn't intended, run <Text inline="true" fontFamily="$fontFamily-monospace" value="git init" />
      in <Text inline="true" fontWeight="$fontWeight-bold" value="{enhanceStatus.value.projectRoot}" />
      or launch Bram at the repository root.
    </Text>
    <SpaceFiller />
    <Button
      label="✕"
      variant="ghost"
      size="xs"
      tooltip="Dismiss for this session"
      onClick="toplevelBannerDismissed = true" />
  </HStack>

  <!-- issue-353: a stray Setup scaffold in the home directory (from an
       earlier mis-launch at $HOME). The host computes strayHomeScaffold
       at startup but until now nothing in the pane used it — Walt's
       machine ran two days with auto-setup silently skipped for every
       repo under home. Same session-scoped dismissal as the toplevel
       banner above. -->
  <HStack
    when="{enhanceStatus.value &amp;&amp; enhanceStatus.value.strayHomeScaffold &amp;&amp; !strayScaffoldBannerDismissed}"
    backgroundColor="$color-warn-100"
    padding="$space-2"
    gap="$space-3"
    wrapContent="true"
    verticalAlignment="center">
    <Text fontSize="$fontSize-sm">
      A Bram scaffold exists in your home directory
      (<Text inline="true" fontFamily="$fontFamily-monospace" value="{enhanceStatus.value.strayHomeScaffold}" />),
      likely from an earlier launch at
      <Text inline="true" fontFamily="$fontFamily-monospace" value="~" /> by mistake.
      It can make projects under your home directory misbehave — remove the stray
      <Text inline="true" fontFamily="$fontFamily-monospace" value="~/resources" /> and
      <Text inline="true" fontFamily="$fontFamily-monospace" value="~/.bram.json" /> to clear this.
    </Text>
    <SpaceFiller />
    <Button
      label="✕"
      variant="ghost"
      size="xs"
      tooltip="Dismiss for this session"
      onClick="strayScaffoldBannerDismissed = true" />
  </HStack>

  <!-- issue-320: gate on providerNeedsSetup ALONE, not activeProvider. The
       host now answers providerNeedsSetup project-level when no provider is
       active, so a fresh/failure-path launch (auto-setup skipped or failed)
       finally shows the manual-fallback banner. The message (below) is
       already provider-neutral; the codex-hook-refresh variant only appears
       when Codex is the active provider. -->
  <VStack
    when="{enhanceStatus.value && enhanceStatus.value.providerNeedsSetup && !setupCompleteProvider}"
    padding="$space-4"
    gap="$space-3"
    backgroundColor="$color-info-50"
    borderBottom="1px solid $color-info-200">
<HStack verticalAlignment="center" gap="$space-2">
  <Heading level="h3">
    {enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh'
      ? 'Refresh Agent Coordination'
      : 'Set Up Agent Coordination'}
  </Heading>
  <Button
    label="ⓘ"
    variant="ghost"
    size="sm"
    tooltip="{enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh' ? 'About agent coordination refresh' : 'About agent coordination setup'}"
    onClick="setupInfoDialog.open()" />
</HStack>
<Text
  when="{enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh'}"
  fontSize="$fontSize-sm">
  Bram was upgraded. Refresh the coordination files so Claude and Codex use the current conventions and hooks.
</Text>
<Text
  when="{!(enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh')}"
  fontSize="$fontSize-sm">
  Install Bram's worklist coordination files and agent adapters for this repo.
</Text>
<HStack>
  <Button
    label="{enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh' ? 'Refresh Coordination' : 'Run Setup'}"
    onClick="setupCompleteProvider = (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || 'setup'; runEnhanceSetup.execute()" />
</HStack>
  </VStack>

  <HStack
    when="{setupCompleteProvider}"
    backgroundColor="$color-info-100"
    padding="$space-2"
    gap="$space-3"
    verticalAlignment="center">
    <!-- Agent restart only: nothing Setup writes is read by the Bram process
         solely at startup (the guard link is ticker-ensured, routes read
         files per request), so the old "Restart Bram" half of this message
         was ceremony. Hooks ARE captured at agent-session startup, so the
         agent restart is the one real requirement — and only on this manual
         fallback path; the automatic path runs Setup before the agent
         launches (first-run-sequence-greeting-vs-setup). -->
    <Text fontSize="$fontSize-sm">
      Setup complete. Restart the agent in the terminal (exit Claude or Codex, then start it again) to pick up the new coordination files.
    </Text>
    <SpaceFiller />
    <Button
      label="✕"
      variant="ghost"
      size="xs"
      tooltip="Dismiss"
      onClick="setupCompleteProvider = ''" />
  </HStack>

  <!-- The tool-descriptions launch banner was retired here
       (retire-tool-desc-launch-banner): its copy predated keyless native
       descriptions, and the footer tip carries the enhancement pitch. -->

  <!-- Explicit warn-scale highlight colors for the Markdown find <mark>
       (active match a shade darker), set app-side so the color is guaranteed
       regardless of the bundle's defaultThemeVars emission. -->
  <Theme paddingVertical-Pages="0" paddingVertical-content-App="0"
    backgroundColor-mark-markdown="$color-warn-200"
    backgroundColor-markActive-markdown="$color-warn-400">
    <Pages fallbackPath="/worklist2">
      <Page url="/needs-you"><Inbox /></Page>
      <Page url="/"><Worklist /></Page>
      <Page url="/worklist"><Worklist /></Page>
      <Page url="/worklist2"><Worklist /></Page>
      <Page url="/transcript"><Transcript agentId="{transcriptAgentId}" /></Page>
      <Page url="/search"><Search /></Page>
      <Page url="/queue"><AgentMessageQueue /></Page>
      <Page url="/status"><Status /></Page>
      <Page url="/settings"><Settings /></Page>
      <Page url="/sessions"><Sessions /></Page>
      <Page url="/tips"><Tips /></Page>
      <Page url="/context"><Context activeProvider="{enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider}" /></Page>
      <Page url="/issues"><Issues /></Page>
      <Page url="/commits"><Commits /></Page>
      <Page url="/history"><History /></Page>
    </Pages>
  </Theme>
  <Footer>
    <Theme fontSize-TextArea="$fontSize-lg" fontSize-placeholder-TextArea="$fontSize-lg">
    <VStack width="100%" gap="$space-1">
      <!-- issue-278: the Worklist gate, docked. The gate row could not be
           pinned where it lived (sticky cannot escape its containing block;
           `dock` needs a bounded parent height and scrollWholePage="false").
           The Footer is the surface `vertical-sticky` actually pins, so the
           buttons live here and the composer below serves as their message
           box - one box, whose target is named by its placeholder. -->
      <!-- The gate bar follows the Worklist page onto every route that
           renders it — including '/', which 1cd9315 remapped from the
           deleted Workspace. A route serving the page without its footer
           gate produced a working board whose ticks lit no buttons
           (xmlui instance, 2026-08-25: publish with no subscriber until a
           route change mounted the bar). -->
      <WorklistGateBar when="{$pathname === '/worklist2' || $pathname === '/worklist' || $pathname === '/'}" />
      <HStack
        width="100%"
        verticalAlignment="center"
        paddingHorizontal="$space-1"
        paddingBottom="$space-2"
        gap="$space-4">
        <!-- Agent-status labels isolated into their own component (own
             agent-status subscription) so the frequent status pushes no longer
             re-render this footer's message composer. The working-verb/spinner
             rationale now lives in FooterAgentStatus.xmlui. Measured by the
             footer-churn / heartbeat-batch instrument. -->
        <!-- footer-status-respects-chip-slot: the old three-zone layout
             reserved a centered 6rem slot for the chip, and a long status
             painted over it (overflowMode="none" let the label escape its
             star zone). Review verdict: overlap is worse than losing chip
             centering — so the chip now renders IN FLOW directly after the
             status verb (the placement its comment always described; the
             fixed slot only approximated it), the status ellipsizes within
             its star width (see FooterAgentStatus), and nothing on the line
             can overlap anything. Nothing reserves space when the chip is
             hidden. -->
        <HStack width="*" verticalAlignment="center" gap="$space-0_5">
          <!-- Isolated in its own component so PTY-throughput churn does not
               re-render this footer's message composer. -->
          <ActivitySparkline />
          <!-- switch-to-transcript-on-action: the status row splits 50/50 —
               agent status left, context line right. The new-below chip
               moved to the bottom row's fixed-width lead slot. -->
          <FooterAgentStatus
            width="*"
            enhanceStatus="{enhanceStatus.value}"
            runningSubagentCount="{window.__bramRunningSubagentCount(footerAgents.value)}" />
          <!-- ONE combined context line — "Selected in Worklist: a, b" with
               the claim verb parenthesized when work is in flight
               ("… (Refining…)"). WRAPS rather than ellipsizing: item ids are
               long, and the id is the message (Text wraps by default in a
               width-constrained container —
               xmlui.org/docs/howto/wrap-long-text-in-a-link). -->
          <PushSource id="footerSel" initial="{[]}" subscribe="{window.bramSubscribeW2Selection()}" />
          <!-- footer-says-proposing-new-item: no boot-state route by design —
               a missed proposing-changed event just degrades to today's
               silence until the next set/clear. `false` skips the
               /__event/latest replay fetch that other PushSources use for
               boot recovery (see bramSubscribeTauriEvent in helpers.js). -->
          <PushSource id="footerProposing" initial="{null}" subscribe="{window.bramSubscribeTauriEvent('proposing-changed', false)}" />
          <HStack width="*" verticalAlignment="center" var.footerProposingFlag="{!!(footerProposing.value &amp;&amp; footerProposing.value.payload &amp;&amp; footerProposing.value.payload.proposing)}">
            <Text
              when="{!!window.__bramFooterContextLine(headerInflightClaim.value, footerProposingFlag, footerSel.value)}"
              width="100%"
              fontSize="$fontSize-md"
              fontStyle="italic"
              color="$color-primary-600"
              value="{window.__bramFooterContextLine(headerInflightClaim.value, footerProposingFlag, footerSel.value)}" />
          </HStack>
        </HStack>
        <!-- switch-to-transcript-on-action: the indexing status moved to the
             bottom session-info row (flush right), clearing this row's right
             edge — it was clipping against the status zone. -->
      </HStack>
      <!-- Canonical pending-menu surface: menus render HERE — below the
           status verb, above the message box — the same place on every tab,
           always visible. Replaces the Transcript inline interleave and the
           Worklist-dock mount (AgentMenuView is self-gating on menu and
           owns its preview modal, so the footer mount is drop-in). -->
      <AgentMenuView menu="{footerAgentMenuEvt.value}" surface="footer" />
      <!-- The hot TextArea is isolated from this App-scope footer. Props flow
           down only when provider state changes; the low-frequency Skills
           request flows up as a component event. -->
      <!-- switch-to-transcript-on-action: the addressee signal lives in the
           composer's own placeholder (no extra line); route rides in as a
           prop because $pathname is Main-scope. -->
      <MessageAgentComposer
        route="{$pathname}"
        activeProvider="{enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider}"
        onSkillsRequested="window.__bramOpenSkillsLauncher(skillsList, skillsDialog)" />
      <!-- Subagent chips strip (surface-subagent-activity-in-pane):
           shown only when the active session has subagents. Clicking a
           chip swaps the Transcript viewport to that agent's stream;
           Main swaps back. Placement per approval feedback: footer,
           below the message box, above the session-info line. Capped at
           the 3 most recently started agents; older ones collapse into
           the rightmost "+N more" dropdown so a subagent-heavy session
           can't crowd the footer. Tooltips carry type, description, and
           the model the subagent ran on. -->
      <HStack
        when="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).length > 0 || (window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).length : 0) > 0}"
        width="100%"
        horizontalAlignment="center"
        gap="$space-1"
        paddingHorizontal="$space-1"
        verticalAlignment="center">
        <Button
          label="Main"
          size="xs"
          variant="outlined"
          tooltip="{window.__bramMainChipTooltip ? window.__bramMainChipTooltip(footerAgents.value) : 'Show the main conversation in the Transcript tab'}"
          onClick="transcriptAgentId = ''; window.__bramSetVisibleRange(null); navigate('/transcript')" />
        <!-- One continuous reverse-chron read: newest chip leftmost (after
             Main), then the dropdown continues newest→oldest top-down. Each
             chip pairs its label with a ghost ✕ that appends the agentId to
             dismissedAgentIds (dismissible-subagent-chips); dismissing a
             visible chip promotes the next agent up from the dropdown. The
             Main chip is intentionally never dismissible. -->
        <Items data="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).slice(-3).reverse()}">
          <HStack gap="0" verticalAlignment="center">
            <!-- surface-delegated-work-in-flight: the ● glyph
                 (__bramAgentChipLabel) was the only truthful signal that a
                 subagent is still running, and it read as the quietest
                 pixel on the page. A running chip now goes solid+primary
                 (filled, accent) instead of the quiet outlined+secondary a
                 finished chip keeps — Button's own themeColor/variant
                 props, no new component. -->
            <Button
              label="{window.__bramAgentChipLabel($item)}"
              size="xs"
              variant="{$item.finished ? 'outlined' : 'solid'}"
              themeColor="{$item.finished ? 'secondary' : 'primary'}"
              tooltip="{(window.__bramAgentChipTooltip || window.__bramAgentChipLabel)($item)}"
              onClick="transcriptAgentId = $item.agentId; window.__bramSetVisibleRange(null); navigate('/transcript')" />
            <Button
              label="✕"
              size="xs"
              variant="ghost"
              tooltip="Dismiss this subagent — restore it later from the hidden menu"
              onClick="dismissedAgentIds = window.__bramDismissAgent(dismissedAgentIds, $item.agentId)" />
          </HStack>
        </Items>
        <DropdownMenu
          when="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).length > 3}"
          label="{'+' + (window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).length - 3) + ' more'}"
          alignment="end"
          triggerButtonVariant="outlined">
          <Items data="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).slice(0, -3).reverse()}">
            <MenuItem
              label="{window.__bramAgentChipLabel($item)}"
              tooltip="{(window.__bramAgentChipTooltip || window.__bramAgentChipLabel)($item)}"
              onClick="transcriptAgentId = $item.agentId; window.__bramSetVisibleRange(null); navigate('/transcript')" />
          </Items>
        </DropdownMenu>
        <!-- Recover dismissed subagents (subagent-dismiss-recoverable): shown
             only while the live roster still contains dismissed agents. Each
             entry restores that pane; Restore all clears the set. Reachable
             even when every subagent is hidden, because the strip's when also
             opens for hidden-in-roster agents. -->
        <DropdownMenu
          when="{(window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).length : 0) > 0}"
          label="{(window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).length : 0) + ' hidden'}"
          alignment="end"
          triggerButtonVariant="ghost">
          <Items data="{window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).slice().reverse() : []}">
            <MenuItem
              label="{'↩ ' + window.__bramAgentChipLabel($item)}"
              tooltip="{'Restore ' + (window.__bramAgentChipTooltip || window.__bramAgentChipLabel)($item)}"
              onClick="dismissedAgentIds = window.__bramRestoreAgent(dismissedAgentIds, $item.agentId)" />
          </Items>
          <MenuItem
            label="Restore all"
            onClick="dismissedAgentIds = window.__bramRestoreAllAgents()" />
        </DropdownMenu>
      </HStack>
      <!-- Session info with the transcript viewport (Main / subagent)
           reported after the provider token — selection lives here, not
           in chip styling, so dropdown-overflow agents indicate the same
           way. Falls back to the plain meta line until a rebuilt
           helpers.js provides __bramFooterSessionLine. -->
      <!-- switch-to-transcript-on-action: the bottom compound — new-below
           chip FIRST (most salient) in a fixed-width slot so the rest of
           the line never jitters as the chip appears, disappears, or its
           count changes; then session info; indexing flush right.
           SpaceFiller is the sanctioned ends-alignment idiom
           (xmlui.org/docs/howto/align-items-to-row-ends-with-spacefiller). -->
      <HStack
        when="{window.__bramSessionMetaLine(window.__bramCurrentSessionOf(footerSessions.value))}"
        width="100%"
        verticalAlignment="center"
        paddingHorizontal="$space-1">
        <!-- Gentle pulse while the agent is done and this content is
             unlooked-at — the ActivitySparkline's animation idiom. The
             animation rides the wrapping HStack, the sparkline's proven
             host: the first attempt put it on the Button, which silently
             ignored it (field-tested 2026-09-07, no pulse under correct
             conditions). The slot is fixed-width, so animating the wrapper
             moves nothing but opacity. -->
        <HStack
          width="5.5rem"
          verticalAlignment="center"
          animation="{transcriptUnseen.value > 0 &amp;&amp; window.__bramChipShouldPulse(mainAgentStatus.value) ? 'fadein' : ''}"
          animationOptions="{{ duration: 2000, reverse: true, loop: true }}">
          <Button
            when="{transcriptUnseen.value > 0}"
            label="{'▼ ' + transcriptUnseen.value + ' new'}"
            size="xs"
            variant="outlined"
            tooltip="New transcript content — jump to the live edge"
            onClick="window.__bramUnseenJump(); navigate('/transcript')" />
        </HStack>
        <Text
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          maxLines="1"
          value="{(window.__bramFooterSessionLine || window.__bramSessionMetaLine)(window.__bramCurrentSessionOf(footerSessions.value), transcriptAgentId, footerAgents.value)}" />
        <SpaceFiller />
        <Text
          when="{footerIndexStatus.value &amp;&amp; window.__bramFooterIndexLabel(footerIndexStatus.value)}"
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          maxLines="1"
          value="{window.__bramFooterIndexLabel(footerIndexStatus.value)}" />
      </HStack>
      <!-- Passive send-ledger note — in the sticky footer so it's always
           visible. Text comes from the host ledger's resolved outcomes;
           recovery is automatic. Dismissal is keyed to the producing
           ledger entry's id (esc-banner-dismissable): ✕ hides THIS
           notice instantly and across reloads; a new resolved entry
           notices normally. -->
      <VStack
        when="{window.__bramSendLedgerNotice(sendLedgerDs.value, sendNoticeDismissed)}"
        padding="$space-2"
        gap="$space-1"
        backgroundColor="$color-info-50"
        borderTop="1px solid $color-info-200">
        <HStack gap="$space-2" verticalAlignment="center">
          <Text
            fontSize="$fontSize-sm"
            width="*"
            value="{window.__bramSendLedgerNotice(sendLedgerDs.value, sendNoticeDismissed)}" />
          <Button
            label="✕"
            variant="ghost"
            size="xs"
            tooltip="Dismiss this notice"
            onClick="sendNoticeDismissed = window.__bramDismissSendNotice(window.__bramSendLedgerNoticeKey(sendLedgerDs.value))" />
        </HStack>
      </VStack>
      <!-- Terminal-attention banner (issue-234): fires only when the host
           detector is active AND the terminal pane is hidden (derived in
           the bramSubscribeTerminalAttention bridge, helpers.js). No
           dismiss button by design — it clears itself on PTY activity
           (host-side) or when the terminal becomes visible (client-side
           join), so there is nothing to hand-dismiss. -->
      <VStack
        when="{terminalAttentionEvt.value &amp;&amp; terminalAttentionEvt.value.active}"
        padding="$space-2"
        gap="$space-1"
        backgroundColor="$color-warn-50"
        borderTop="1px solid $color-warn-200">
        <HStack gap="$space-2" verticalAlignment="center">
          <Text
            fontSize="$fontSize-sm"
            width="*"
            color="$color-warn-700"
            value="The terminal is waiting at a prompt Bram can't answer." />
          <Button
            label="Open terminal"
            variant="outlined"
            size="xs"
            onClick="window.__bramOpenTerminalForAttention()" />
        </HStack>
      </VStack>
      <!-- Compaction-in-progress banner (compaction-in-progress-banner):
           fires when the host's CompactionTracker sees the live PTY tail
           CONTAINS the provider's "Compacting conversation" progress line
           AND the terminal pane is hidden (derived in the
           bramSubscribeCompaction bridge, helpers.js). This is a
           text-PRESENCE detector, not terminal_attention's byte-silence
           one — compaction actively prints a spinner, so it auto-clears
           the moment the tail no longer shows that line (compaction
           finished). Informational, not a warning: compaction is
           autonomous and needs no answer, so this uses the info palette
           (not warn) and, unlike the terminal-attention banner above,
           carries a ✕ dismiss (send-ledger-notice idiom) that hides only
           the current episode — a later compaction re-shows it. -->
      <VStack
        when="{compactionEvt.value &amp;&amp; compactionEvt.value.active}"
        padding="$space-2"
        gap="$space-1"
        backgroundColor="$color-info-50"
        borderTop="1px solid $color-info-200">
        <HStack gap="$space-2" verticalAlignment="center">
          <Text
            fontSize="$fontSize-sm"
            width="*"
            color="$color-info-700"
            value="Compacting context — the agent will resume shortly." />
          <Button
            label="✕"
            variant="ghost"
            size="xs"
            tooltip="Dismiss this notice"
            onClick="window.__bramDismissCompaction()" />
        </HStack>
      </VStack>
      <!-- issue-231 footer tips: one context-driven, dismissible Tip line at
           the footer bottom, picked by window.__bramPickTip from the settings
           snapshot. Re-picks on mount and on footerTipTick bumps; Next skips
           for this session, the cross dismisses permanently. Existence guard
           keeps a stale binary (pre-tips helpers.js) from throwing. -->
      <HStack
        when="{window.__bramPickTip ? window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) : null}"
        gap="$space-2"
        paddingHorizontal="$space-2"
        paddingVertical="$space-1"
        verticalAlignment="center"
        marginTop="$space-1"
        backgroundColor="$color-surface-50"
        borderTop="1px solid $borderColor">
        <!-- Clickable only when the tip carries a link: external url opens
             in the system browser, internal route navigates in-pane, and a
             linkless tip renders as plain text. -->
        <!-- Plain Text wraps (width=* flex child, same as the send-ledger
             note above); a nested Text inside Link cannot (the anchor is an
             inline-flex whose child never shrinks). So the tip text is always
             plain, and the link rides an explicit Open button. -->
        <Text
          width="*"
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          value="{(window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) || {}).text}" />
        <Button
          when="{window.__bramTipLink ? window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick) : ''}"
          label="Open"
          variant="ghost"
          size="xs"
          tooltip="Open the related page"
          onClick="window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick).indexOf('http') === 0 ? openExternal(window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick)) : navigate(window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick))" />
        <Button
          label="Next"
          variant="ghost"
          size="xs"
          tooltip="Show a different tip"
          onClick="footerTipTick = window.__bramSkipTip((window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) || {}).id, footerTipTick)" />
        <Button
          label="✕"
          variant="ghost"
          size="xs"
          tooltip="{window.__bramTipDismissTooltip ? window.__bramTipDismissTooltip() : 'Dismiss this tip'}"
          onClick="footerTipTick = window.__bramDismissTip((window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) || {}).id, footerTipTick)" />
      </HStack>
    </VStack>
    </Theme>
  </Footer>
</App>

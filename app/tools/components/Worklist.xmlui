<Component
  name="Worklist"
  var.expandedKeys="{window.__bramRestoreWorklist2Expansion($queryParams.expand)}"
  var.diffKeys="{[]}"
  var.diffScopes="{{}}"
  var.hunkNavKeys="{{}}"
  var.worklist2Feedback="{{}}"
  var.worklist2NewItemOpen="{!!$queryParams.newIssue}"
  var.worklist2NewItemIssue="{$queryParams.newIssue ? Number($queryParams.newIssue) : null}"
  var.worklist2VoiceRecording="{false}"
  var.worklist2VoiceItemId="{''}"
  var.worklist2Sent="{{}}"
  var.worklist2Selected="{(window.__bramW2Selection || []).slice()}"
  var.worklist2OverlapOpen="{false}"
  >
  <!-- Worklist2: the redesigned, evidence-first gate (tutorial gist v3).
       Binds the same /__worklist payload Workspace uses, so the two tabs
       cannot disagree about state. Two-level compression: a row-level
       expander with the file table plus Before / After / Diff sections.

       worklist2-keyed-expansion: expansion is CONTROLLED — it lives only
       in expandedKeys (persisted, id-keyed), never in component
       internals. ExpandableItem is uncontrolled (initiallyExpanded reads
       once at mount), so positional row reuse in the Items loop carried
       expansion state across items when the list changed (pruned-item
       state transfer, 2026-08-20). Chevron Button + when-bound body per
       https://www.xmlui.org/docs/howto/keep-per-item-state-in-a-loop —
       the old tab's proven shape. -->
  <DataSource
    id="worklist"
    url="/__worklist"
    transformResult="{(d) => window.__bramWorklistAccept(d)}"
    onLoaded="(d) => expandedKeys = window.__bramPruneWorklist2Expansion(d &amp;&amp; d.items ? d.items.map(i => i.id) : [])" />
  <!-- The component-local selection resets on a Worklist remount, but the
       Footer's shared selection bridge survives it. Reconcile on the
       authoritative item set so a prune/remount publishes [] instead of
       leaving buttons lit for an id whose row no longer exists. Surviving
       selected ids are retained. -->
  <ChangeListener
    listenTo="{worklist.value &amp;&amp; worklist.value.items}"
    onDidChange="() => worklist2Selected = window.__bramSelectionIds(worklist.value &amp;&amp; worklist.value.items, worklist2Selected)" />
  <!-- inbox-open-lands-expanded: Awaiting You's Open deep-links
       /worklist2?expand=<id>; the var default consumes the param at mount,
       this listener covers a param change while already mounted
       ($queryParams is reactive:
       https://www.xmlui.org/docs/howto/deep-link-to-a-tab-or-section). -->
  <ChangeListener
    listenTo="{$queryParams.expand}"
    onDidChange="expandedKeys = window.__bramConsumeExpandParam(expandedKeys, $queryParams.expand)" />
  <!-- issues-blank-bram-cell-starts-item: the Issues page's blank Bram cell
       deep-links /worklist2?newIssue=<n> to open the new-item composer with
       that issue preselected. Var defaults consume the param at mount; these
       listeners cover a param change while already mounted, one assignment
       each (the expand-param pattern above). -->
  <ChangeListener
    listenTo="{$queryParams.newIssue}"
    onDidChange="worklist2NewItemIssue = $queryParams.newIssue ? Number($queryParams.newIssue) : worklist2NewItemIssue" />
  <ChangeListener
    listenTo="{$queryParams.newIssue}"
    onDidChange="worklist2NewItemOpen = $queryParams.newIssue ? true : worklist2NewItemOpen" />
  <!-- instrument-w2-selection-handoff: the prune's own view, logged before the
       assignment above lands, so a refetch that arrives with zero items is
       visible as the cause rather than inferred from the publish that follows. -->
  <ChangeListener
    listenTo="{worklist.value &amp;&amp; worklist.value.items}"
    onDidChange="() => window.__bramIframeTrace('w2-selection', {op: 'prune-input', items: ((worklist.value &amp;&amp; worklist.value.items) || []).length, selected: (worklist2Selected || []).length})" />
  <!-- strip-label-tense-for-applied-items: the summary strip's first
       priority is the host's claim record (Approving…/Iterating…/…), so
       read /__inflight and refetch on its push event — the same payload
       and idiom as the old tab's #265 indicators, so the two tabs cannot
       tell different stories about what is in flight. -->
  <DataSource id="inflightClaim" url="/__inflight" />
  <PushSource
    id="inflightClaimEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('inflight-claim-changed')}" />
  <ChangeListener
    listenTo="{inflightClaimEvt.value &amp;&amp; inflightClaimEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(inflightClaimEvt.value, inflightClaim, worklist)" />
  <!-- count-changed-files-rung1: the payload's change activity derives
       from git status, so refetch on the host's git-status-changed event
       (push over polling; same idiom as Commits.xmlui). -->
  <PushSource
    id="gitStatusEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('git-status-changed', false)}" />
  <ChangeListener
    listenTo="{gitStatusEvt.value &amp;&amp; gitStatusEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(gitStatusEvt.value, worklist)" />
  <!-- worklist2-first-action sync fix: worklist-changed is the event
       every worklist.json write emits and the old tab's primary refetch
       trigger; without it the board desyncs exactly when items are added
       or pruned (observed live 2026-08-20: one row shown, two on disk). -->
  <PushSource
    id="worklistChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('worklist-changed')}" />
  <ChangeListener
    listenTo="{worklistChangedEvt.value &amp;&amp; worklistChangedEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(worklistChangedEvt.value, worklist)" />
  <!-- Parity: the old tab's last-exchange dock rides the projection
       subscription (workspace-tail-subscription). -->
  <!-- worklist2-feedback-input-parity: voice transcripts arrive on the
       shared subscription; per-row listeners below route by target. -->
  <PushSource
    id="w2VoiceArrival"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceArrival()}" />
  <!-- overlap-hover-row-emphasis: focus published by the Review-overlaps
       table's rowEnter/rowLeave; rows tint below while their id is in the
       focused claimant set. -->
  <PushSource
    id="overlapFocus"
    initial="{window.__bramOverlapFocus}"
    subscribe="{window.bramSubscribeOverlapFocus()}" />
  <!-- issue-278: publish the selection so the Footer's gate bar can read it.
       The gate row is moving to the Footer because that is the one surface
       this App layout pins ("vertical-sticky ... the footer sticks to the
       bottom"); the rows keep owning the selection, they just announce it. -->
  <ChangeListener
    listenTo="{worklist2Selected}"
    onDidChange="() => window.__bramW2SetSelection(worklist2Selected)" />
  <!-- instrument-w2-selection-handoff (observe only, TRIPWIRE).
       A sibling listener rather than extra statements in the one above:
       attribute handlers stay a single call.
       `items` is the discriminator. The leading hypothesis is that the prune
       listener above fires during a refetch when `worklist.value.items` is
       momentarily empty, wiping the selection - while the row Checkbox uses
       `initialValue` (UNCONTROLLED, same class as the ExpandableItem trap) so
       it keeps showing ticked. That shape reads `op=publish count=0 items=0`
       and settles it in one grep, which reading the code twice did not. -->
  <ChangeListener
    listenTo="{worklist2Selected}"
    onDidChange="() => window.__bramIframeTrace('w2-selection', {op: 'publish', count: (worklist2Selected || []).length, items: ((worklist.value &amp;&amp; worklist.value.items) || []).length, store: (window.__bramW2Selection || []).length})" />
  <!-- w2-selection-store-to-page-sync: the missing return direction. The
       gate-bar submit path clears the STORE directly (helpers.js,
       __bramW2SetSelection([])), which the 2026-08-24 capture showed as a
       publish-less `receive count=0` while this page kept `selected=1`
       and the row Checkbox stayed ticked - a selection matching no
       buttons, stable forever because the store setter early-returns on
       equal input. Bridge the store back in (same subscription the
       Footer's gateSel consumes) so the store is the source of truth in
       both directions. No ping-pong: the trace proves ChangeListener
       compares by value (prune's fresh-array assigns never fired
       publish), and __bramW2SetSelection early-returns regardless. The
       Checkbox needs no change: initialValue re-evaluates when
       worklist2Selected changes (shared-array idiom,
       https://www.xmlui.org/docs/howto/toggle-multiple-items-with-shared-state). -->
  <PushSource
    id="w2SelStore"
    subscribe="{window.bramSubscribeW2Selection()}" />
  <ChangeListener
    listenTo="{w2SelStore.value}"
    onDidChange="() => worklist2Selected = (w2SelStore.value || []).slice()" />
  <!-- issue-328: the worklist2Close page var and its mirror listener are
       gone — the gate bar owns the close toggle, and the expansion's
       comment box writes window.__bramW2CloseMap directly. -->
  <!-- prototype-gate-on-transcript round 4: projectedTurnsDS is gone with
       the last-exchange dock it fed (sole consumer). The helpers.js
       projected-turns machinery stays — dormant here, still the transport
       other surfaces could subscribe to. -->
  <VStack padding="$space-4" gap="$space-3">
    <HStack gap="$space-3" verticalAlignment="center" paddingBottom="$space-2">
      <H2>Worklist</H2>
      <!-- Parity: + New item. Inline ask (the old tab's dialog distilled):
           items are proposed by the agent; this composes that ask. -->
      <Button
        label="+ New item"
        size="xs"
        onClick="worklist2NewItemOpen = !worklist2NewItemOpen" />
      <!-- issue-278 rung 1: the board states its own overlap total, so a
           reader knows the per-row marks are exhaustive without reading every
           row. Says "no shared files" when there are none - the absence is
           worth one word, and it keeps the line from appearing and vanishing.
           Counts CHANGED overlap (declared paths that are actually dirty), not
           declared overlap: two items planning to touch one file is not
           contention, and reporting it as such is what made this surface feel
           like it was announcing a problem rather than naming one. The
           declared fact keeps its home at the Start click, where
           __bramStartConsequence raises it when it becomes consequential.
           "across all N items" marks universality, which is what the clique
           degenerates to and the useful collapsed fact when everyone claims
           one file. -->
      <SpaceFiller />
      <Text
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        width="*"
        textAlign="start"
        overflowMode="flow"
        value="{window.__bramOverlapHeaderLine(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}" />
      <Button
        when="{window.__bramOverlapAny(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}"
        label="{worklist2OverlapOpen ? 'Hide overlaps' : 'Review overlaps'}"
        variant="ghost"
        size="xs"
        onClick="worklist2OverlapOpen = window.__bramOverlapToggleOpen(worklist2OverlapOpen)" />
    </HStack>
    <!-- issue-278 rung 2: the overlap index. One disclosure owns the graph,
         so a row never has to render its peer set - at twenty dense items that
         is the same news twenty times. Ordered HAZARD BEFORE POPULARITY by
         __bramOverlapIndex: a file with begun claimants outranks a more
         popular one with none, because whole-file staging makes the begun case
         the one that can produce a mixed commit. In document flow, NOT pinned:
         a large index stuck to the top would consume the viewport it exists to
         summarise. -->
    <!-- Gated on overlaps existing, matching the toggle Button's own gate:
         when the last overlap vanishes while the panel is open, the button
         disappears and an open panel would otherwise strand as an empty
         "No data available" table with no control left to close it
         (observed post-teardown, 2026-08-24). -->
    <VStack
      when="{worklist2OverlapOpen &amp;&amp; window.__bramOverlapAny(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}"
      gap="$space-1"
      padding="$space-3"
      border="1px solid $color-surface-200"
      borderRadius="$borderRadius">
      <Text fontWeight="$fontWeight-bold" value="Shared files" />
      <!-- Table with proportional Columns, not hand-rolled HStacks with fixed
           rem widths. The hand-rolled version wasted horizontal space on every
           row (a 22rem FILE column for paths that are mostly shorter) and then
           had nothing left for CLAIMED BY. Reaching for `FlowLayout` to fix
           that cell made it worse still - every badge stretched to full
           container width, one per line - and it was the wrong component
           regardless: FlowLayout carries an upstream deprecation notice,
           "Please use HStack with wrapContent set to true; it will overtake
           the role of FlowLayout" (xmlui `FlowLayout.tsx:26`). Checking the
           component docs first would have said so; reaching for a layout by
           name is how a deprecated one gets into a file.

           Jon: "Terrible layout solution. Just wasting all kinds of space. We
           want these things natural width and wrappable. We already had a
           solution to that."

           We did: the expanded row's file table right below, which has used
           `Table` + proportional `Column` + `HStack wrapContent="true"` all
           along (see the shared-with Column). Same shape, same problem, and it
           was solved once already - this is that solution, reused rather than
           reinvented. -->
      <!-- overlap-hover-row-emphasis: hovering a row publishes its claimant
           ids (rowEnter fires once per row, not per cell; rowLeave is the
           clearing pair — the engine events vendored in 869cc89). Worklist
           rows subscribe and tint: the claimant→row tie the issue-278 graph
           was recruited for, delivered on the surface that won. -->
      <!-- overlap-pin-on-click: clicking a row pins its highlight so
           scrolling can review the full correlation; same-row click
           releases, another row moves the pin, collapsing the disclosure
           releases (__bramOverlapToggleOpen). Clicks live on full-width
           cell wrappers because Table has no row-click event yet (the
           xmlui-side board is proposing one; collapse to onRowClick when
           it lands). The cell tint doubles as the pinned-row cue. -->
      <Table
        data="{window.__bramOverlapDisplayIndex(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}"
        onRowEnter="(item) => window.__bramSetOverlapFocus(item.claimants)"
        onRowLeave="window.__bramClearOverlapFocus()">
        <Column header="file" width="2*">
          <HStack
            width="100%"
            cursor="pointer"
            backgroundColor="{window.__bramOverlapPinnedRow(overlapFocus.value, $item.path) ? '$color-primary-100' : 'transparent'}"
            onClick="window.__bramToggleOverlapPin($item.path, $item.claimants)">
            <Text
              value="{$item.path}"
              variant="code"
              fontSize="$fontSize-sm"
              color="{$item.planned ? '$textColor-secondary' : '$textColor-primary'}"
              tooltip="{$item.path}" />
          </HStack>
        </Column>
        <Column header="items" width="110px">
          <HStack
            width="100%"
            cursor="pointer"
            backgroundColor="{window.__bramOverlapPinnedRow(overlapFocus.value, $item.path) ? '$color-primary-100' : 'transparent'}"
            onClick="window.__bramToggleOverlapPin($item.path, $item.claimants)">
            <Text
              fontSize="$fontSize-sm"
              color="$textColor-secondary"
              overflowMode="flow"
              value="{window.__bramOverlapRowCount($item, worklist.value &amp;&amp; worklist.value.items) + ($item.planned ? ' · planned' : '')}" />
          </HStack>
        </Column>
        <!-- Natural-width badges that wrap: `wrapContent="true"`, the same
             property the shared-with Column below already uses. The one
             surviving colour tie is row badge <-> here, so these keep the
             item's own colour; the short label carries identity when two
             items collide on a hue, which they do past six items. -->
        <!-- Static on purpose: a binding expression in Column `header`
             silently unmounts the whole Table (observed live, 2026-09-03; no
             console error, no render). Filed as xmlui-org/xmlui#3867 — when
             dynamic headers land, this label follows its rows' tense
             ("planned by" / "claimed by"), as does the file table's
             "files expected to change" header below (expected vs changed,
             the same tense problem). Until then the two-tense label plus the
             per-row `· planned` marker carry the distinction. -->
        <Column header="planned / claimed by" width="3*">
          <HStack
            width="100%"
            cursor="pointer"
            backgroundColor="{window.__bramOverlapPinnedRow(overlapFocus.value, $item.path) ? '$color-primary-100' : 'transparent'}"
            onClick="window.__bramToggleOverlapPin($item.path, $item.claimants)">
            <Text overflowMode="flow" value="{window.__bramJoinIds($item.claimants)}" />
          </HStack>
        </Column>
      </Table>
    </VStack>
    <!-- worklist2-new-item-parity: thin composition of existing pieces.
         IsolatedDraftEditor brings the placeholder protocol, voice, paste
         and drag-resize as a unit (voice/paste target new-item, shared
         with the old dialog's machinery); the issue Select restores the
         issue-driven path (issue-<N>- ids + closesIssues key off the
         composed phrasing). The instructional prose is gone by design. -->
    <DataSource
      id="w2OpenIssues"
      url="/__issues"
      when="{worklist2NewItemOpen}" />
    <VStack
      when="{worklist2NewItemOpen}"
      gap="$space-2"
      padding="$space-3"
      border="1px solid $color-surface-200"
      borderRadius="$borderRadius">
      <Select
        when="{!!w2OpenIssues.value}"
        placeholder="Optional: cite an open issue"
        data="{((w2OpenIssues.value) || []).filter(i => i.state === 'OPEN').map(i => ({value: i.number, label: '#' + i.number + ' ' + i.title}))}"
        initialValue="{worklist2NewItemIssue}"
        onDidChange="(v) => worklist2NewItemIssue = v">
        <!-- new-item-select-left-justify: the default value renderer centers
             wrapped titles. A width-constrained Text wraps flush-left (its
             default alignment); no theme var covers value alignment, so the
             template is the mechanism
             (xmlui.org/docs/reference/components/Select#valuetemplate). -->
        <property name="valueTemplate">
          <Text width="100%" textAlign="start" value="{$item.label}" />
        </property>
      </Select>
      <IsolatedDraftEditor
        id="w2NewItemEditor"
        placeholder="Describe what the item should change"
        minRows="2"
        maxRows="16"
        width="100%"
        voiceTarget="new-item"
        pasteTarget="new-item"
        inlineImagePreview="true"
        voiceTooltip="Dictate worklist item" />
      <HStack gap="$space-2">
        <Button
          label="Propose item"
          size="sm"
          onClick="(() => {
            const issuesArr = (w2OpenIssues.value) || [];
            const issueObj = worklist2NewItemIssue ? issuesArr.find(i => String(i.number) === String(worklist2NewItemIssue)) : null;
            const text = (w2NewItemEditor.getValue() || '').trim();
            if (!issueObj &amp;&amp; !text) return;
            let msg;
            if (issueObj &amp;&amp; text) { msg = 'Propose a worklist item to address #' + issueObj.number + ' (' + issueObj.title + '): ' + text; }
            else if (issueObj) { msg = 'Propose a worklist item to address #' + issueObj.number + ' (' + issueObj.title + ').'; }
            else { msg = 'Propose a worklist item: ' + text; }
            window.__bramIframeTrace('click', {target: 'worklist2-new-item', issue: issueObj ? issueObj.number : 0});
            toTurn(window.__bramWithStagedImageMarkers(msg, 'new-item'));
            worklist2NewItemOpen = false; worklist2NewItemIssue = null; setWorklistVoiceTarget('message-agent'); w2NewItemEditor.clear();
          })()" />
        <Button
          label="Cancel"
          variant="ghost"
          size="sm"
          onClick="worklist2NewItemOpen = false; worklist2NewItemIssue = null; setWorklistVoiceTarget('message-agent'); w2NewItemEditor.clear()" />
      </HStack>
    </VStack>
    <!-- Cutover complete: this IS the Worklist (nav label, heading,
         component name). Only the /worklist2 route remembers the preview
         era; the legacy Workspace tab and its setting were retired in the
         0.5.3 run. -->
    <Text
      when="{worklist.value &amp;&amp; (!worklist.value.items || worklist.value.items.length === 0)}"
      color="$textColor-secondary">
      (no items)
    </Text>
    <Items data="{worklist.value &amp;&amp; worklist.value.items ? worklist.value.items : []}">
      <!-- Row separation (review 2026-08-20): breathing room between
           items, which matters most when rows are expanded. Tightened
           2026-08-24 from $space-4 to $space-2 — with the stage glyph column
           gone (6d5d05b) each collapsed row is a single line of text, and
           four units of padding under a one-line row read as a gap rather
           than as separation. Expanded rows still get their air from the
           inner gap. -->
      <VStack
        gap="$space-1"
        paddingBottom="$space-2"
        testId="worklist-row-{$item.id}">
        <!-- worklist2-remove-expander-chrome: no indicator glyphs (History's
             chrome-free section headers are the precedent); the header line
             itself is the toggle. The selection Checkbox sits OUTSIDE the
             toggling region so ticking never flips expansion.

             The overlap-focus tint lives HERE, on the expander line, not on
             the row container: tinting the container floods an expanded
             row's whole body (file table, Before/After) and drowns what it
             marks (2026-09-03: "only tint the expander not its contents"). -->
        <HStack
          gap="$space-2"
          verticalAlignment="center"
          borderRadius="$borderRadius"
          backgroundColor="{window.__bramOverlapFocusedRow(overlapFocus.value, $item.id) ? '$color-primary-100' : 'transparent'}">
          <!-- issue-343: the claim no longer paints a tick. A box that is
               disabled while a claim is live (enabled= below) but RENDERED
               ticked reads as a selection — Andrew's user "selected two
               rows" that were claim-ticks, clicked Start, and the real
               selection was empty. The visual state must match what Start
               will receive; the claimed row's marker is its Spinner. -->
          <Checkbox
            initialValue="{(worklist2Selected || []).includes($item.id)}"
            enabled="{window.__bramWorklist2RowSelectable(inflightClaim.value)}"
            onDidChange="(v) => worklist2Selected = window.__bramToggleRowSelection(worklist2Selected || [], $item.id, v)" />
          <HStack
            gap="$space-2"
            verticalAlignment="center"
            width="*"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id)">
          <!-- rethink-activity-indicators: row-prepended spinner while
               the HOST's claim covers this item — a decision being
               carried out, host state, never inferred agent activity.
               A plural (batch) claim lights all its rows. -->
          <Theme size-Spinner="14px">
            <Spinner when="{window.__bramItemInflightKind(inflightClaim.value, $item.id, '', '', 0)}" />
          </Theme>
          <!-- Badge's text prop is `value` (not `label` — the
               ExpandableItem doc's summary example is wrong, filed
               upstream as xmlui-org/xmlui#3814). Contrast matched to
               Search's facet chips via theme vars:
               https://www.xmlui.org/docs/howto/theme-badge-colors-and-sizes -->
          <!-- The stage glyph column is GONE (2026-08-24). It sat in a
               fixed-width slot precisely so state could be read vertically
               without reading any row - but the strip beside it already names
               the same state in words, three characters to the right, so the
               glyph said nothing the word did not and cost a legend to learn.
               Same argument that retired the per-item colours: an accelerator
               that stopped paying for itself.
               The four designed states collapsed to three in practice (Jon:
               "with the agent, proposed, and will commit are the only three
               states you are likely to see"), and encoding that few as shapes
               is a legend for a distinction nobody needed help with.
               What was genuinely lost: the glyphs formed a straight left edge,
               and the strip text cannot, since it trails a variable-length id.
               That was judged not load-bearing because the states differ by
               length and colour, not subtly - a lone "Will commit +70 -2 ..."
               row is unmissable among "Proposed" rows. If state-scanning ever
               does get hard at higher density, the fix is an aligned column for
               the TEXT, not new glyphs - and note the 18rem fixed-width badge
               slot tried earlier wrapped to two lines and was worse than the
               raggedness it fixed.
               `__bramWorklist2Stage` went with it - the icon was its only
               caller, so `.icon`, `.label` and `.yours` all lost their
               consumers at once. The four-state logic it carried is not lost:
               the committable-before-needsStart precedence it established
               lives on in `__bramSelectionAllNeedStart`. -->
          <!-- The badge carries the item's colour, and the Shared files
               table's claimant names carry the same one, so a claimant can be
               matched to its row without reading either id. -->

            <!-- The id, not a derived short label. Rung 3 shortened these to
                 `#278 · SEMANTIC` and it did fix the measured problem - badge
                 width spread fell 22 -> 12 chars, which is what made the
                 strip's left edge ragged at ten items. But it invented a
                 SECOND NAME for something that already had one, and the alias
                 leaked into prose: "commit #278 · OVERLAP" is not an
                 instruction anyone can act on without translating it back.
                 Jon: "The short names are making it hard for me to follow your
                 instructions and that is an indictment of the method."

                 Truncation preserves identity; a derived label creates an
                 alias. So the raggedness is fixed with WIDTH - a fixed slot
                 the badge clips inside - and the name stays the id. -->
          <!-- Plain primary text, no background. This was the last Badge in
               the Worklist; the grey chip was the residue of the colour
               encoding after the colour itself was removed, and a chip with no
               colour is just a background asking to be read as one.
               Natural width, so it never wraps (Jon: "make the main badges not
               wrap"); the earlier fixed-width slot is what forced two-line
               ids. -->
          <!-- worklist2-id-column (2026-09-03, Jon: "align the messages in a
               second column"): a fixed-width slot so every strip starts at the
               same x. This is the aligned-column fix the comments above (L426,
               L449) always pointed to; the earlier attempt's two-line-id
               regression is avoided by maxLines=1 + ellipsis truncation, with
               the full id recoverable in the tooltip it already carries. -->
          <Text
            value="{$item.id}"
            tooltip="{$item.id}"
            width="17rem"
            maxLines="1"
            overflowMode="ellipsis" />
          <!-- Basenames in the line, full paths in the tooltip: the row is a
               scan line and repo-relative paths would swamp it.

               Base size, not -sm (Jon, on the first live render: "messages
               need larger font so the new colorized text has a chance to stand
               out"). At -sm the amber had too little ink to register as a
               signal at all - the colour was carrying meaning the type was too
               small to deliver. -->
          <!-- width="*" bounds the flow wrap: without it the Text sizes to
               content, overflows the row edge, and clips mid-word instead of
               wrapping inside the available width (observed 2026-09-03). -->
          <!-- fontSize one notch below base: the base size was chosen when
               the strip carried colorized amber text that needed ink to
               register; those colors are gone, so -sm reads fine and reclaims
               vertical space. -->
          <Text
            width="*"
            fontSize="$fontSize-sm"
            color="$textColor-secondary"
            overflowMode="flow"
            tooltipMarkdown="{window.__bramWorklist2StripTooltip($item, inflightClaim.value, worklist.value &amp;&amp; worklist.value.items, worklist.value &amp;&amp; worklist.value.attributionTotals)}"
            value="{window.__bramWorklist2Strip($item, inflightClaim.value, worklist.value &amp;&amp; worklist.value.items, worklist.value &amp;&amp; worklist.value.attribution, worklist.value &amp;&amp; worklist.value.attributionTotals)}" />
          <!-- issue-278: the row backlink is GONE, on live evidence.
               It was redundant and, worse, it put a SECOND meaning of "shared"
               on a line that already had one. Live board, 2026-08-24:

                 Will commit +323 -2 in 2 of 2 planned - 1 shared - last: ...
                                                        ^ shared CHANGED files
                                        ... shares 2 files with 2 items
                                                   ^ shared CLAIMED files

               Two numbers, two meanings, one line. Jon: "I don't think the
               colorized message is helping us here ... they just make the whole
               message row too long ... a more compact and less misleading
               solution."

               The expanded row's SHARED WITH column already does this job and
               does it better: colour-matched claimant badges, per file, where
               the file is the subject. Overlap is a property of files, so the
               file table is where it belongs; the scan line keeps one sentence
               with one meaning. Board-level total stays in the header. -->
          </HStack>
        </HStack>
        <VStack
          when="{(expandedKeys || []).includes($item.id)}"
          gap="$space-2"
          paddingLeft="$space-6">
          <!-- No section header: the table renders directly on row expand
               (review 2026-08-20: "On expand the table tells the story with
               one less click"). Plan-vs-activity survives in the CONTENT:
               plain name list for plans, activity table for begun rows. -->
          <VStack
            when="{($item.changedFiles || window.__bramWorklistItemFiles($item)).length > 0}"
            gap="$space-1"
            var.rowBegun="{window.__bramWorklist2Begun($item, inflightClaim.value)}"
            var.rowId="{$item.id}"
            var.rowItem="{$item}"
            var.filesColCh="{window.__bramFilesColumnCh($item.changedFiles)}">
            <!-- Files touched as a Table (Status.xmlui idiom). Per-file
                 shared-files flags live here beside the file they concern,
                 not on the status line. Plain-path fallback covers payloads
                 without the rung-1 enrichment. -->
            <!-- The table renders for plan rows too (review 2026-08-20:
                 "the table display with the file overlap is important for
                 understanding what to do next and possible entanglement").
                 Only the activity numbers are begun-gated - a plan row
                 shows path + shared-with, never sibling bleed as its own
                 changes. -->
            <!-- The table renders for every row, including plan rows with
                 nothing in the numeric columns. Swapping to a plain list when
                 there was nothing to report made the shape jump between rows
                 and read as two different displays; the header carries the
                 meaning instead. "files expected to change" is true before any
                 work happens (it is the plan) and stays true after (it is what
                 changed), so one label covers the whole lifecycle and the
                 empty cells read as not-yet rather than missing. -->
            <!-- worklist-diff-shared-file-provenance: an Items loop, not a
                 Table, because each file row opens its own diff beneath it and
                 Table has no row-expansion affordance (filed upstream as
                 xmlui-org/xmlui#3857). Nothing Table gave us here is in use —
                 no sorting, selection, pagination or inference — only header
                 labels and proportional widths, and star sizing is the same
                 vocabulary in HStack:
                 https://www.xmlui.org/docs/howto/set-width-for-input-fields-in-a-horizontal-layout

                 The diff belongs on the file row for the same reason the
                 shared-with column does: it is a property of the file. Attaching
                 it here is what stops a shared file's neighbouring hunks from
                 reading as this item's work — they are never concatenated into
                 one body — and turns a 2,000-line untracked file into a row you
                 may decline to open rather than a wall. -->
            <!-- issue-327 file-table experiment: header row and file rows are
                 a real Table, so the columns align by construction. Table has
                 no single-click row event (only rowDoubleClick and hover —
                 the Review-overlaps table above uses the hover pair), so
                 "click the file row to open it" is single-row selection per
                 the master-detail pattern:
                 https://www.xmlui.org/docs/howto/build-a-master-detail-layout
                 Selecting a row opens its Tabs below the table; selecting
                 another switches. diffKeys stays the expansion source of
                 truth — the Table's own selection is internal, positional
                 state (the ExpandableItem class), trusted only for the
                 highlight. -->
            <Table
              when="{$item.changedFiles}"
              data="{$item.changedFiles}"
              idKey="path"
              rowsSelectable="{rowBegun}"
              enableMultiRowSelection="{false}"
              onSelectionDidChange="(sel) => diffKeys = window.__bramTableSelectDiff(diffKeys, rowId, sel)">
              <!-- "expected to change" is the planning tense; on a begun row
                   whose work is done it should read "changed". Same
                   static-header constraint as the overlaps table — waits on
                   xmlui-org/xmlui#3867 (dynamic Column headers). -->
              <Column header="files expected to change" width="2*" headerHorizontalAlignment="start">
                <Text
                  variant="code"
                  fontSize="$fontSize-sm"
                  value="{$item.path}" />
              </Column>
              <!-- 200px: the entangled "of" form ("+170 −1 of +416 −18")
                   clipped its tail at 140px. -->
              <Column header="changes" width="200px" headerHorizontalAlignment="start">
                <!-- Entangled rows lead with the item's own take ("+170 −1 of
                     +404 −18") so the header is visibly the sum of the
                     column's first numbers — the addends were invisible
                     before (Jon, 2026-09-04: "still does not add up"). -->
                <Text
                  variant="code"
                  fontSize="$fontSize-sm"
                  value="{window.__bramFileChangesCell($item, rowBegun)}" />
              </Column>
              <Column header="shared with" width="3*" headerHorizontalAlignment="start">
                <!-- worklist-surface-planned-overlap: two tenses, carried by
                     LEADING LABELS in plain text, not by style (Jon,
                     2026-09-04: "don't use color. lead with done: or
                     planned:"). `done:` = that item's changes are in this
                     file now; `planned:` = it merely declares this file —
                     zero of the CHANGES-column lines are its. Style-only
                     distinction failed twice: muting read as accident, and
                     the counts read as belonging to the sharers. -->
                <VStack gap="$space-0">
                  <Text
                    when="{window.__bramSharedWithBegun($item, worklist.value &amp;&amp; worklist.value.items, inflightClaim.value).length > 0}"
                    overflowMode="flow"
                    value="{'done: ' + window.__bramJoinIds(window.__bramSharedWithBegun($item, worklist.value &amp;&amp; worklist.value.items, inflightClaim.value))}" />
                  <Text
                    when="{window.__bramSharedWithPlanned($item, worklist.value &amp;&amp; worklist.value.items, inflightClaim.value).length > 0}"
                    overflowMode="flow"
                    value="{'planned: ' + window.__bramJoinIds(window.__bramSharedWithPlanned($item, worklist.value &amp;&amp; worklist.value.items, inflightClaim.value))}" />
                </VStack>
              </Column>
            </Table>
            <Items
              when="{$item.changedFiles}"
              data="{$item.changedFiles}">
              <VStack gap="$space-0" width="100%">
                <!-- Gated on rowBegun, carried down from the section that used
                     to hold the single Diff view: a plan row that has begun
                     nothing must offer no diffs, or it would display a
                     neighbour's uncommitted work as its own. -->
                <VStack
                  when="{rowBegun &amp;&amp; window.__bramDiffExpanded(diffKeys, rowId, $item.path) &amp;&amp; window.__bramDiffForPath(rowItem, $item.path)}"
                  paddingBottom="$space-2"
                  var.filePatch="{(window.__bramDiffForPath(rowItem, $item.path) || {}).patch || ''}"
                  var.fileRuns="{((worklist.value &amp;&amp; worklist.value.attribution) || {})[$item.path]}">
                  <!-- issue-327: two views of one file. keepMounted because Tabs
                       mounts only the active panel by default, and DiffView owns
                       a DataSource posting to /__diff/annotate: without it every
                       switch unmounts the diff and re-annotates it.
                       https://www.xmlui.org/docs/reference/components/Tabs -->
                  <Tabs keepMounted="true">
                    <TabItem label="Diff">
                      <!-- issue-327 scoped diff: scope, don't annotate. Every
                           rendered diff has ONE owner — "All changes" is the
                           combined patch (commit truth: whole-file staging takes
                           all of it), and each claimant scope is that item's own
                           interval diff, fetched lazily on selection. The
                           Gerrit patch-set / GitHub per-commit convention; a
                           scoped diff is against the item's own base, so its
                           line numbers may not match the current file — that is
                           what lets it show superseded work.
                           https://www.xmlui.org/docs/reference/components/DataSource -->
                      <VStack
                        gap="$space-1"
                        var.fileScope="{window.__bramDiffScope(diffScopes, rowId, $item.path, fileRuns)}">
                          <DataSource
                            id="scopedDiff"
                            when="{fileScope !== '__all'}"
                            url="/__worklist/interval-diff"
                            queryParams="{{ id: fileScope, path: $item.path }}" />
                          <HStack
                            when="{(fileRuns || []).length > 0}"
                            gap="$space-2"
                            verticalAlignment="center">
                            <Text variant="caption" value="Changes:" />
                            <!-- valueTemplate: the selected value renders
                                 centered by default and there is no theme var
                                 for its alignment; a full-width start-aligned
                                 Text is the documented fix.
                                 https://www.xmlui.org/docs/howto/customize-a-selects-selected-value -->
                            <Select
                              width="30rem"
                              data="{window.__bramDiffScopeOptions(filePatch, fileRuns, rowId)}"
                              initialValue="{fileScope}"
                              onDidChange="(v) => diffScopes = window.__bramSetDiffScope(diffScopes, rowId, $item.path, v)">
                              <property name="valueTemplate">
                                <Text width="100%" textAlign="start" value="{$item.label}" />
                              </property>
                            </Select>
                          </HStack>
                          <!-- worklist-file-hunk-navigation: step through the
                               ACTIVE patch's hunks (the scope selector decides
                               which patch renders, so nav counts the same
                               capped text the DiffView shows). Cursor is
                               id-keyed in hunkNavKeys; scroll finds the hunk
                               header inside the wrapper below. -->
                          <HunkNav
                            when="{window.__bramHunkCount(cappedDiffText(fileScope === '__all' ? filePatch : ((scopedDiff.value || {}).patch || ''))) > 0}"
                            matchCount="{window.__bramHunkCount(cappedDiffText(fileScope === '__all' ? filePatch : ((scopedDiff.value || {}).patch || '')))}"
                            current="{window.__bramHunkNavGet(hunkNavKeys, rowId, $item.path, 'diff')}"
                            onStep="(d) => hunkNavKeys = window.__bramDiffHunkStep(hunkNavKeys, rowId, $item.path, d, cappedDiffText(fileScope === '__all' ? filePatch : ((scopedDiff.value || {}).patch || '')), fileScope === '__all' ? diffAllView : diffScopedView)" />
                          <DiffView
                            id="diffAllView"
                            when="{fileScope === '__all'}"
                            text="{cappedDiffText(filePatch)}" />
                          <DiffView
                            id="diffScopedView"
                            when="{fileScope !== '__all' &amp;&amp; !!(scopedDiff.value &amp;&amp; scopedDiff.value.patch)}"
                            text="{cappedDiffText(scopedDiff.value.patch)}" />
                          <Text
                            when="{fileScope !== '__all' &amp;&amp; scopedDiff.value &amp;&amp; !scopedDiff.value.patch}"
                            variant="caption"
                            value="No changes recorded in this scope's claim intervals for this file." />
                      </VStack>
                    </TabItem>
                    <!-- Ownership is a SUMMARY from the row item's point of
                         view, not a line-by-line rendering — the file view was
                         rejected at rendered review as illegible. One row per
                         claimant: their own added lines, and the one thing the
                         scoped diff cannot show — whether their work shares a
                         hunk with this item's (inseparable in a whole-file
                         commit) or sits in separate hunks. -->
                    <TabItem label="Ownership">
                      <!-- Same column geometry as the file table above
                           (filesColCh / 140px / star, $space-2 gap), so the
                           claimant sits under "files expected to change", the
                           count under "changes", and the relation under
                           "shared with". No item colors: the "(this item)"
                           suffix and the relation text carry the meaning. -->
                      <VStack gap="$space-1" paddingVertical="$space-2">
                        <!-- Separability is measured on demand (git apply
                             check, host-side), one fetch per expanded file —
                             never on board build. Relations stay blank until
                             the verdicts arrive rather than guessing. -->
                        <DataSource
                          id="pathIndependence"
                          url="/__worklist/independence"
                          queryParams="{{ path: $item.path }}" />
                        <Table data="{window.__bramOwnershipSummary(filePatch, fileRuns, rowId, pathIndependence.value)}">
                          <Column header="claimant" width="3*" headerHorizontalAlignment="start">
                            <Text
                              variant="code"
                              fontSize="$fontSize-sm"
                              value="{window.__bramClaimantCell($item, rowId)}" />
                          </Column>
                          <Column header="unique" width="90px" headerHorizontalAlignment="start">
                            <Text
                              variant="code"
                              fontSize="$fontSize-sm"
                              value="{'+' + $item.added}" />
                          </Column>
                          <Column header="what commit does" width="3*" headerHorizontalAlignment="start">
                            <Text
                              overflowMode="flow"
                              value="{$item.relation}" />
                          </Column>
                        </Table>
                      </VStack>
                    </TabItem>
                    <!-- worklist-file-context-view: the WHOLE current file with
                         each item's lines tinted in place — the big picture the
                         scoped Diff and the Ownership summary lose. Reuses
                         /__local-file-preview (working-tree content, 200 KB cap)
                         and the payload's attribution runs. Fetches on expand;
                         one local read per opened file. -->
                    <TabItem label="File">
                      <VStack gap="$space-0" paddingVertical="$space-2">
                        <!-- file-tab-truncation-misses-changes: this view wants
                             the WHOLE file (elision keeps the DOM small); the
                             route's 200 KB default is for point previews and
                             silently served a 2.4 MB lib.rs as its first
                             ~4,900 lines, hiding the item's changes entirely. -->
                        <DataSource
                          id="fileContext"
                          url="{'/__local-file-preview?maxBytes=8000000&amp;path=' + encodeURIComponent($item.path)}" />
                        <VStack
                          when="{fileContext.value &amp;&amp; fileContext.value.ok}"
                          gap="$space-0"
                          var.ctxRows="{window.__bramFileContextRows(fileContext.value.content, fileRuns, rowId, worklist.value &amp;&amp; worklist.value.items)}">
                          <!-- worklist-file-hunk-navigation: step through the
                               highlight blocks. The List virtualizes, so the
                               step helper scrolls via scrollToIndex on the
                               component ref — a DOM query cannot reach an
                               unmounted row
                               (https://www.xmlui.org/docs/reference/components/List#scrolltoindex).
                               Large files arrive already elided: unhighlighted
                               stretches collapse into labeled cut rows in
                               __bramFileContextRows, so every block is nearby. -->
                          <Text
                            when="{window.__bramFileTruncationNote(fileContext.value)}"
                            fontSize="$fontSize-sm"
                            color="$textColor-secondary"
                            value="{window.__bramFileTruncationNote(fileContext.value)}" />
                          <HunkNav
                            when="{window.__bramFileHunkCount(ctxRows) > 0}"
                            noun="highlight"
                            matchCount="{window.__bramFileHunkCount(ctxRows)}"
                            current="{window.__bramHunkNavGet(hunkNavKeys, rowId, $item.path, 'file')}"
                            onStep="(d) => hunkNavKeys = window.__bramFileHunkStep(hunkNavKeys, rowId, $item.path, d, ctxRows, fileCtxList)" />
                          <!-- worklist2-file-tab-rerender-blowup: List, not
                               Items — Items re-renders every element on every
                               render and is documented for <~100 items
                               (xmlui.org/docs/howto/iterate-without-a-container-element);
                               a 200 KB file is thousands of rows. List
                               virtualizes inside its own bounded viewport.
                               Ownership colors ride on the row objects (bg/fg,
                               baked in __bramFileContextRows with the memoized
                               array identity) so no per-row binding touches
                               worklist.value. -->
                          <List
                            id="fileCtxList"
                            data="{ctxRows}"
                            idKey="k"
                            height="24rem">
                            <HStack
                              width="100%"
                              gap="$space-2"
                              verticalAlignment="start"
                              backgroundColor="{$item.bg}">
                              <Text
                                width="3rem"
                                textAlign="end"
                                variant="caption"
                                fontFamily="$fontFamily-monospace"
                                fontSize="$fontSize-xs"
                                color="$textColor-secondary"
                                value="{$item.n}" />
                              <Text
                                width="*"
                                whiteSpace="pre-wrap"
                                fontFamily="$fontFamily-monospace"
                                fontSize="$fontSize-sm"
                                color="{$item.fg}"
                                value="{$item.text}" />
                            </HStack>
                          </List>
                          <Text
                            when="{fileContext.value.truncated}"
                            variant="caption"
                            color="$textColor-secondary"
                            paddingTop="$space-1"
                            value="⋯ file truncated at 200 KB; owned regions past this point are not shown." />
                        </VStack>
                        <Text
                          when="{fileContext.value &amp;&amp; !fileContext.value.ok}"
                          variant="caption"
                          value="{(fileContext.value &amp;&amp; fileContext.value.error) || 'Preview unavailable.'}" />
                      </VStack>
                    </TabItem>
                  </Tabs>
                </VStack>
              </VStack>
            </Items>
            <!-- Fallback for payloads without the rung-1 enrichment, where
                 there is no changedFiles array to build a table from. -->
            <Items
              when="{!$item.changedFiles}"
              data="{window.__bramWorklistItemFiles($item)}">
              <Text value="{$item}" variant="code" fontSize="$fontSize-sm" />
            </Items>
          </VStack>
          <!-- prose-section-headers-clickable: chevron + pointer + accent so
               these read as toggles, not labels — the file rows' old glyph
               vocabulary, applied to all three prose siblings uniformly. -->
          <HStack
            when="{$item.before}"
            gap="$space-1"
            verticalAlignment="center"
            cursor="pointer"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id + '::before')">
            <Text
              color="$color-primary-600"
              value="{((expandedKeys || []).includes($item.id + '::before') ? '▾ ' : '▸ ') + 'Before'}" />
          </HStack>
          <VStack
            when="{(expandedKeys || []).includes($item.id + '::before') &amp;&amp; $item.before}"
            paddingLeft="$space-6">
            <Markdown content="{$item.before}" interpolateBindings="false" allowHtml="false" />
          </VStack>
          <HStack
            when="{$item.after}"
            gap="$space-1"
            verticalAlignment="center"
            cursor="pointer"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id + '::after')">
            <Text
              color="$color-primary-600"
              value="{((expandedKeys || []).includes($item.id + '::after') ? '▾ ' : '▸ ') + 'After'}" />
          </HStack>
          <VStack
            when="{(expandedKeys || []).includes($item.id + '::after') &amp;&amp; $item.after}"
            paddingLeft="$space-6">
            <Markdown content="{$item.after}" interpolateBindings="false" allowHtml="false" />
          </VStack>
          <!-- worklist-diff-shared-file-provenance: the item-level Diff
               section is gone. Each file's diff now opens on its own row in the
               table above, where the shared-with column that says whose work it
               is sits beside it. Concatenating every declared file into one body
               is what made a neighbour's hunks read as this item's, and what
               rendered a single large untracked file as a wall. The begun-gate
               that used to live on this section moved onto the rows. -->
          <!-- worklist2-commit-action: the close declaration as stated fact
               with tickbox override on begun rows (default ticked; untick
               to keep an issue open) — the old tab's inline pattern, at
               its final home. Plan rows keep the plain declaration. -->
          <!-- worklist2-dim-sent-feedback (as clarified): a Feedback
               SECTION under Diff - multiple entries, reverse
               chronological, rendered exactly as worklist-history does.
               Entries accumulate per verb-send for the item's life on
               the board. -->
          <HStack
            when="{(((worklist2Sent || {})[$item.id] || []).concat($item.feedbackHistory || [])).length > 0}"
            gap="$space-1"
            verticalAlignment="center"
            cursor="pointer"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id + '::feedback')">
            <Text
              color="$color-primary-600"
              value="{((expandedKeys || []).includes($item.id + '::feedback') ? '▾ ' : '▸ ') + 'Feedback'}" />
          </HStack>
          <VStack
            when="{(expandedKeys || []).includes($item.id + '::feedback') &amp;&amp; (((worklist2Sent || {})[$item.id] || []).concat($item.feedbackHistory || [])).length > 0}"
            gap="$space-2"
            paddingLeft="$space-6">
            <Items data="{(((worklist2Sent || {})[$item.id] || []).concat($item.feedbackHistory || []))}">
              <VStack gap="$space-1">
                <Text
                  fontSize="$fontSize-xs"
                  color="$textColor-secondary"
                  value="{'Feedback · ' + new Date($item.atMs).toLocaleTimeString()}" />
                <Markdown content="{$item.text}" interpolateBindings="false" allowHtml="false" />
              </VStack>
            </Items>
          </VStack>
          <!-- issue-328 single surface: the expansion's whole closes block
               is GONE — checkbox first (gate-only toggle, 5e0618d), then
               label and comment box too ("i thought we got rid of the
               double closer"). The gate line carries consent AND the
               optional closing comment; the strip's "· closes #N" remains
               as information, not a control. -->
        </VStack>
      </VStack>
    </Items>
    <!-- worklist2-batch-selection (as clarified): ONE control row serves
         one or several — the Iterate-N principle applied to every verb.
         Appears when anything is ticked; the message is about the set and
         fans out to each selected item's payload entry. -->
    <!-- issue-278 rung 4: the gate row is never out of reach while a
         selection is live.

         The failure it fixes is structural, not incidental. This surface is
         gated on a selection existing and rendered INLINE after the list, so:
         tick a row -> the controls appear below the list -> expand the row you
         are deciding about -> the list grows -> the controls leave the
         viewport. Reading the thing you are deciding about is what hides the
         control for deciding. Jon: "the problem is losing the button row below
         the fold. That is the first, most important next thing to fix."

         StickySection stickTo="bottom" is the XMLUI-native answer and already
         the pane's idiom for the top edge (Transcript.xmlui:162,
         Search.xmlui:253).
         https://www.xmlui.org/docs/reference/components/StickySection

         Sticky gives most of the agreed contract structurally rather than by
         care: it IS an inline anchor that pins only when it would scroll out
         of view, so "inline when visible, docked when not" and the reserved
         height are the primitive's own behaviour. It repositions rather than
         re-creates, which satisfies the rule with teeth - the message box
         calls setWorklistVoiceTarget('feedback') on focus and paste routing
         reads that mirror, so a remount would drop focus, a half-typed
         message, or the paste target, and a pasted screenshot would land in
         the wrong box. Sticky cannot remount it.

         What sticky does NOT give is the latch (dock on first occlusion, stay
         docked until the selection clears): native sticky releases as soon as
         the anchor scrolls back into view, so collapsing a row pops the bar
         back inline. Deliberately not added yet - the flap may not be
         perceptible when the trigger is a deliberate expand/collapse rather
         than incidental scrolling, and that is worth observing before it is
         engineered around. -->
    <VStack
      when="{(worklist2Selected || []).length > 0}"
      gap="$space-1"
      padding="$space-2"
      borderRadius="$borderRadius"
      backgroundColor="$color-surface-50">
    <!-- issue-278: the composer and the gate buttons moved to the Footer.
         There were two message boxes - this one and the agent composer - and
         the fix is one box whose target is named by its placeholder (Jon: "The
         duplication of the message box here is resolved by only having one of
         them ... when you're on the Worklist page, it's targeting the selected
         set"). The buttons went with it, because the Footer is the only
         surface `vertical-sticky` pins; see WorklistGateBar.xmlui.
         What stays here is selection-scoped CONTENT - the share-mode
         choice - which is reading material, not controls. -->
    <!-- The board-wide Shared files table that sat here was removed
         (0.5.3 gate run, 2026-08-24): a board-scoped fact panel stacked
         under a selection-scoped decision, and its content is now carried
         by the per-row "N shared" strip counts, the expanded rows'
         Shared-with column, the gate explainer line, and on demand by the
         header's Review overlaps disclosure — which remains the one home
         of the whole-board view. -->

    <!-- The commit-granularity share-mode radio moved to the footer
         (WorklistGateBar.xmlui), above the gate buttons, so it can never
         sit below the fold. -->
    </VStack>
    <!-- prototype-gate-on-transcript round 4 (docs/transcript-gate-unification.md):
         the You/Agent last-exchange dock is GONE. The drive's finding: an
         excerpt on the Worklist never carried enough evidence, and the
         evidence surface already exists — the Transcript. The loop closes
         from the other side now: a gate button press auto-switches to the
         Transcript (__bramGateAct in helpers.js), so acting hands you the
         full conversation instead of a peek. This reverses the earlier
         dock-and-dim design (2026-08 era) by the same author's live verdict;
         the dock's markup is in git history if the pendulum swings back. -->
  </VStack>
</Component>

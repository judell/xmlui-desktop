<Component name="WorklistGateBar" var.gateSent="{[]}">
  <!-- issue-278: the Worklist gate, in the Footer.
       The gate row cannot be pinned where it lived - `position: sticky` cannot
       escape its containing block, and `dock` needs a bounded parent height
       plus scrollWholePage="false", which this shell does not have. The Footer
       is the one surface `vertical-sticky` genuinely pins.
       Self-contained DataSources so it needs nothing from App scope; the
       selection arrives by PushSource and the message text from the single
       Footer composer, which now serves both roles. -->
  <DataSource id="gateWorklist" url="/__worklist" transformResult="{(d) => window.__bramWorklistAccept(d)}" />
  <DataSource id="gateConfig" url="/__worklist-config" />
  <DataSource id="gateClaim" url="/__inflight" />
  <PushSource id="gateSel" subscribe="{window.bramSubscribeW2Selection()}" />
  <!-- The composer is an isolated sibling component. Reading its window
       mirror through a helper is not reactive, so Refine stayed dim after
       typing until some unrelated gate render happened. This push source is
       the explicit dependency: input and clear both publish synchronously. -->
  <PushSource id="gateText" subscribe="{window.bramSubscribeMessageAgentText()}" />
  <PushSource
    id="gateWorklistChanged"
    subscribe="{window.bramSubscribeTauriEvent('worklist-changed')}" />
  <ChangeListener
    listenTo="{gateWorklistChanged.value}"
    onDidChange="() => { gateWorklist.refetch(); gateClaim.refetch(); }" />
  <!-- instrument-w2-selection-handoff (observe only, TRIPWIRE): the receiving
       half. `render` is the actual gate on the button row below - buttons are
       ABSENT when it is false, as opposed to greyed, since they gate on
       `enabled=`. A `receive count=0` with the page still showing a ticked
       checkbox is the divergence; a publish with no matching receive is the
       boundary dropping it. Steady state emits pairs, so this is not a
       zero-is-success grep - the anomaly is a mismatch, not a count. -->
  <ChangeListener
    listenTo="{gateSel.value}"
    onDidChange="() => window.__bramIframeTrace('w2-selection', {op: 'receive', count: (gateSel.value || []).length, render: (gateSel.value || []).length > 0, store: (window.__bramW2Selection || []).length})" />

  <!-- gate-button-combo-explainer: why THIS button combo, for the current
       selection. The line is derived in `__bramStartConsequence` from the
       same predicates that light the buttons (begun-ness via
       `__bramWorklist2Begun`, exclusivity via `__bramItemChangedSplit`), and
       may only name a lit action - or a dim one together with why it is dim
       and the selection change that would light it. Empty for unsurprising
       combos: an always-on explainer is furniture (the deleted 2026-08-23
       matrix's lesson).
       A message, never a block: shipping two items as one change is legitimate,
       and the gate's job is to inform the decision rather than make it - the
       same reasoning that keeps unclaimed-changes detection report-only.
       `__bramStartConsequence` returns "" when there is nothing to say, so this
       stays one call with no ternary. -->
  <!-- Centered by an HStack wrapper, matching the button row below. A bare
       `horizontalAlignment` on the Text centers content INSIDE the Text's own
       box, which is content-sized - so the line sat wherever its box landed
       rather than centered in the footer. The Text takes width="100%" because
       text wraps by default only in a width-constrained container
       (xmlui.org/docs/howto/wrap-long-text-in-a-link); content-sized, the
       long explainer wordings overflowed the footer edge-to-edge unwrapped.
       Left-justified (Text's default): centered multi-line prose reads
       ragged both sides; the wrapped explainer scans better flush left. -->
  <!-- worklist.gateExplainer: held in RESERVE, not a product surface. A
       .bram.json that says nothing about it never produces the explainer,
       and there is deliberately no Settings toggle — hand-edit .bram.json
       to bring it back for a debugging/wording exercise (0.5.3 gate run:
       useful for articulating the messages in context, not wanted as
       permanent UI). -->
  <!-- worklist-surface-planned-overlap: the gateExplainer flag gate is
       REMOVED. The 0.5.3 run retired this line from permanent UI, but the
       2026-09-03 live case reversed that verdict for the one thing it says:
       a user deciding whether to Start two items had a board reading "no
       shared files changed" and nothing naming the planned entanglement at
       the decision point. __bramStartConsequence already returns "" except
       when the selection makes it consequential (shared files, or a mixed
       begun/unbegun selection), so un-gating shows text only when there is a
       consequence to state. -->
  <HStack
    when="{!!window.__bramStartConsequence(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value)}"
    horizontalAlignment="center"
    paddingHorizontal="$space-8"
    paddingTop="$space-1">
    <Text
      width="100%"
      value="{window.__bramStartConsequence(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value)}" />
  </HStack>
  <!-- commit-granularity share-mode choice, moved here from the page body
       (0.5.3 gate run: "the radio group belongs above the buttons in the
       footer otherwise can get lost below the fold like the buttons did").
       Writes the window store the gate actions already read
       (__bramW2ShareMode / __bramW2SetShareMode); the page no longer renders
       it. Original design rationale (why the control exists whenever 2+
       committable items are selected, entangled or not) lives in git history
       at Worklist.xmlui, commit-granularity A+B. -->
  <!-- `when` carries the full expression rather than a same-element var:
       a `var.` declared on an element scopes to its CHILDREN, so a `when`
       on that element referencing it fails silently and the control never
       renders (caught live, first render after the move). -->
  <HStack
    var.shareChoiceEntangled="{window.__bramSelectionSharesFiles(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value)}"
    var.shareSplitLabel="{shareChoiceEntangled ? 'A commit each — the agent will separate them' : 'A commit each — selected items land separately'}"
    when="{(gateSel.value || []).length >= 2 &amp;&amp; window.__bramSelectionAllCommittable(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value)}"
    horizontalAlignment="center"
    paddingHorizontal="$space-8"
    paddingTop="$space-1">
    <RadioGroup
      initialValue="{window.__bramW2ShareMode}"
      onDidChange="(v) => window.__bramW2SetShareMode(v)">
      <Option value="together" label="One commit — selected items land together" />
      <Option value="split" label="{shareSplitLabel}" />
    </RadioGroup>
  </HStack>
  <!-- issue-328: close consent AT THE GATE. When the selection carries
       closesIssues, one real checkbox per issue renders here — where the
       decision happens — instead of only inside a row expansion nobody is
       required to open. Default stays ticked (today's behavior, now
       visible); unticking is one click and feeds the same __bramW2CloseMap
       the payload builder reads, so what you see is what the commit sends.
       Fresh rows per evaluation are fine: the checkbox's state lives in
       the map, so a remount re-reads the truth. -->
  <HStack
    when="{(window.__bramGateCloseItems(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value) || []).length > 0}"
    horizontalAlignment="center"
    gap="$space-3"
    paddingTop="$space-1">
    <Items data="{window.__bramGateCloseItems(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value)}">
      <HStack gap="$space-1" verticalAlignment="center">
        <Checkbox
          initialValue="{$item.close}"
          onDidChange="(v) => window.__bramGateCloseToggle($item.itemId, $item.number, v, $item.closesIssues)" />
        <Text
          value="{'closes #' + $item.number}"
          fontSize="$fontSize-sm"
          tooltip="{$item.title}" />
        <!-- issue-328 single surface: the closing comment lives HERE, beside
             the consent it annotates — the row expansion's closes block is
             gone ("i thought we got rid of the double closer"). Same shared
             map as the toggle and the payload builder. -->
        <TextBox
          width="14rem"
          placeholder="closing comment (optional)"
          onDidChange="(v) => window.__bramGateCloseComment($item.itemId, $item.number, v, $item.closesIssues)" />
      </HStack>
    </Items>
  </HStack>
  <HStack
    when="{(gateSel.value || []).length > 0}"
    verticalAlignment="center"
    horizontalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-1"
    paddingTop="$space-1"
    paddingBottom="$space-3">
    <!-- No "N selected · <id>" label, and the count on each button is the
         whole mechanism.
         The consensus design argued a docked bar MUST name its target, since
         docked it can sit far from the ticked row. The premise is right - Jon:
         "almost any expansion is going to lose disjoint selections whose check
         boxes are below the fold" - but the conclusion was wrong, and for a
         reason worth keeping: the count does not have to identify the
         selection, only to say how big it is.
         `Start 2` with one checkbox visible tells you there is a second one
         and sends you to find it. Scrolling or collapsing to it is cheap.
         Naming both would mean enumerating an unbounded set in a fixed band,
         "competing with the buttons" for the space they need - a losing
         proposition. And the obvious escape, an expand-all/collapse-all
         control, "is always a bad smell".
         So this is deliberately a bounded signal that points, not a complete
         one that describes. -->
    <Button
      label="{'Start ' + (gateSel.value || []).length}"
      size="sm"
      enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; window.__bramSelectionAllNeedStart(gateWorklist.value.items, gateSel.value, gateClaim.value)}"
      onClick="window.__bramGateAct('start', gateWorklist.value.items, gateSel.value, window.__bramW2ShareMode)" />
    <Button
      label="{'Start &amp; commit ' + (gateSel.value || []).length}"
      size="sm"
      enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; (gateSel.value || []).length === 1 &amp;&amp; window.__bramSelectionAllNeedStart(gateWorklist.value.items, gateSel.value, gateClaim.value)}"
      tooltip="One click: start, then commit when done. One item at a time — see #272"
      onClick="window.__bramGateAct('start-commit', gateWorklist.value.items, gateSel.value, window.__bramW2ShareMode)" />
    <Button
      label="{'Commit ' + (gateSel.value || []).length}"
      size="sm"
      enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; window.__bramSelectionAllCommittable(gateWorklist.value.items, gateSel.value, gateClaim.value)}"
      onClick="window.__bramGateAct('commit', gateWorklist.value.items, gateSel.value, window.__bramW2ShareMode)" />
    <!-- switch-to-transcript-on-action: Refine retired. It was never an
         authorization — the other gate buttons write auth records; Refine
         wrote none, it was conversation squatting among the signatures from
         the era when the gate row was the only item-addressed surface. The
         composer is that surface now: Enter with a selection sends the same
         iterate fan-out Refine sent (__bramComposerEnterSubmit →
         __bramWorklist2BatchIterate — one mechanism, same wire payload,
         guards and host untouched). The gate row is pure lifecycle:
         Start / Start & commit / Commit / Drop. -->
    <Button
      label="{'Drop ' + (gateSel.value || []).length}"
      size="sm"
      enabled="{!window.__bramInflightBlocker(gateClaim.value)}"
      onClick="window.__bramGateAct('drop', gateWorklist.value.items, gateSel.value, window.__bramW2ShareMode)" />
  </HStack>
</Component>
